Public Function GenerateNextId( _
    ByVal idPrefix As String, _
    ByVal sourceSheetName As String, _
    ByVal idColumn As Long, _
    ByVal counterKey As String _
) As String

    Dim savedNextNumber As Long
    Dim existingMaxNumber As Long
    Dim nextNumber As Long

    If Not WorksheetExists(SHEET_SYSTEM) Then
        Err.Raise _
            vbObjectError + 1002, _
            "GenerateNextId", _
            "システム管理シートがありません。"
    End If

    If Not WorksheetExists(sourceSheetName) Then
        Err.Raise _
            vbObjectError + 1003, _
            "GenerateNextId", _
            sourceSheetName & "シートがありません。"
    End If

    If idPrefix <> DAILY_ID_PREFIX _
        And idPrefix <> RECURRING_ID_PREFIX Then

        Err.Raise _
            vbObjectError + 1004, _
            "GenerateNextId", _
            "IDの接頭文字が不正です。"
    End If

    savedNextNumber = _
        GetSavedNextIdNumber(counterKey)

    existingMaxNumber = GetExistingMaxIdNumber( _
        sourceSheetName, _
        idColumn, _
        idPrefix)

    nextNumber = savedNextNumber

    If nextNumber < existingMaxNumber + 1 Then
        nextNumber = existingMaxNumber + 1
    End If

    If nextNumber < 1 Then
        nextNumber = 1
    End If

    If nextNumber > ID_NUMBER_MAX Then
        Err.Raise _
            vbObjectError + 1005, _
            "GenerateNextId", _
            "業務IDが上限に達しました。"
    End If

    SaveNextIdNumber _
        counterKey, nextNumber + 1

    GenerateNextId = _
        idPrefix & _
        Format$( _
            nextNumber, _
            String$(ID_NUMBER_DIGITS, "0"))
End Function

Public Function IsDuplicateTask( _
    ByVal taskType As String, _
    ByVal taskId As String, _
    ByVal originalDate As Date, _
    Optional ByVal ignoreSheetName As String = vbNullString, _
    Optional ByVal ignoreRow As Long = 0 _
) As Boolean

    Dim targetSheetNames As Variant
    Dim sheetNameValue As Variant
    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim storedDate As Variant

    If Len(Trim$(taskType)) = 0 Then
        Exit Function
    End If

    If Len(Trim$(taskId)) = 0 Then
        Exit Function
    End If

    targetSheetNames = Array( _
        SHEET_TODO_LIST, _
        SHEET_COMPLETED)

    For Each sheetNameValue In targetSheetNames
        If WorksheetExists(CStr(sheetNameValue)) Then
            Set targetSheet = _
                ThisWorkbook.Worksheets( _
                    CStr(sheetNameValue))

            lastRow = GetLastDataRow(targetSheet)

            For rowNumber = DATA_FIRST_ROW To lastRow
                If Not ( _
                    CStr(sheetNameValue) = ignoreSheetName _
                    And rowNumber = ignoreRow) Then

                    If Trim$(CStr(GetSafeCellValue( _
                        targetSheet.Cells( _
                            rowNumber, _
                            COL_TODO_TASK_TYPE)))) = taskType _
                    And Trim$(CStr(GetSafeCellValue( _
                        targetSheet.Cells( _
                            rowNumber, _
                            COL_TODO_TASK_ID)))) = taskId Then

                        storedDate = GetSafeCellValue( _
                            targetSheet.Cells( _
                                rowNumber, _
                                COL_TODO_ORIGINAL_DATE))

                        If IsValidExcelDate(storedDate) Then
                            If DateOnlyValue(storedDate) = _
                                DateValue(originalDate) Then

                                IsDuplicateTask = True
                                Exit Function
                            End If
                        End If
                    End If
                End If
            Next rowNumber
        End If
    Next sheetNameValue
End Function

Public Sub ShowProcessError( _
    ByVal processName As String, _
    Optional ByVal sheetName As String = vbNullString, _
    Optional ByVal rowNumber As Long = 0, _
    Optional ByVal taskId As String = vbNullString, _
    Optional ByVal errorDescription As String = vbNullString _
)

    Dim messageText As String

    messageText = _
        "処理中にエラーが発生しました。" & vbCrLf & _
        "処理：" & processName

    If Len(sheetName) > 0 Then
        messageText = messageText & vbCrLf & _
            "シート：" & sheetName
    End If

    If rowNumber > 0 Then
        messageText = messageText & vbCrLf & _
            "行：" & CStr(rowNumber)
    End If

    If Len(taskId) > 0 Then
        messageText = messageText & vbCrLf & _
            "業務ID：" & taskId
    End If

    If Len(errorDescription) > 0 Then
        messageText = messageText & vbCrLf & _
            "内容：" & errorDescription
    End If

    MsgBox _
        messageText, _
        vbExclamation, _
        APP_TITLE
End Sub

Private Function GetSettingRawValue( _
    ByVal settingName As String, _
    ByRef settingFound As Boolean _
) As Variant

    Dim settingsSheet As Worksheet
    Dim foundCell As Range

    settingFound = False

    If Not WorksheetExists(SHEET_SETTINGS) Then
        GetSettingRawValue = Empty
        Exit Function
    End If

    Set settingsSheet = _
        ThisWorkbook.Worksheets(SHEET_SETTINGS)

    Set foundCell = _
        settingsSheet.Columns( _
            COL_SETTING_NAME).Find( _
                What:=settingName, _
                After:=settingsSheet.Cells( _
                    1, COL_SETTING_NAME), _
                LookIn:=xlValues, _
                LookAt:=xlWhole, _
                SearchOrder:=xlByRows, _
                SearchDirection:=xlNext, _
                MatchCase:=False)

    If foundCell Is Nothing Then
        GetSettingRawValue = Empty
    Else
        settingFound = True

        GetSettingRawValue = _
            settingsSheet.Cells( _
                foundCell.Row, _
                COL_SETTING_VALUE).Value
    End If
End Function

Private Sub ShowInvalidSettingWarning( _
    ByVal settingName As String, _
    ByVal defaultText As String _
)

    MsgBox _
        MSG_INVALID_SETTING_PREFIX & vbCrLf & _
        "項目：" & settingName & vbCrLf & _
        "使用する値：" & defaultText, _
        vbExclamation, _
        APP_TITLE
End Sub

Private Function FindIdRow( _
    ByVal sheetName As String, _
    ByVal idColumn As Long, _
    ByVal taskId As String _
) As Long

    Dim targetSheet As Worksheet
    Dim foundCell As Range

    If Len(Trim$(taskId)) = 0 Then
        Exit Function
    End If

    If Not WorksheetExists(sheetName) Then
        Exit Function
    End If

    Set targetSheet = _
        ThisWorkbook.Worksheets(sheetName)

    Set foundCell = _
        targetSheet.Columns(idColumn).Find( _
            What:=taskId, _
            After:=targetSheet.Cells( _
                HEADER_ROW, idColumn), _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False)

    If Not foundCell Is Nothing Then
        If foundCell.Row >= DATA_FIRST_ROW Then
            FindIdRow = foundCell.Row
        End If
    End If
End Function

Private Function GetExistingMaxIdNumber( _
    ByVal sheetName As String, _
    ByVal idColumn As Long, _
    ByVal idPrefix As String _
) As Long

    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim idValue As String
    Dim numberPart As String
    Dim currentNumber As Long

    Set targetSheet = _
        ThisWorkbook.Worksheets(sheetName)

    lastRow = GetLastDataRow( _
        targetSheet, idColumn)

    For rowNumber = DATA_FIRST_ROW To lastRow
        idValue = Trim$(CStr(GetSafeCellValue( _
            targetSheet.Cells( _
                rowNumber, idColumn))))

        If Len(idValue) = _
            Len(idPrefix) + ID_NUMBER_DIGITS Then

            If Left$(idValue, Len(idPrefix)) = _
                idPrefix Then

                numberPart = Mid$( _
                    idValue, _
                    Len(idPrefix) + 1)

                If numberPart Like _
                    String$(ID_NUMBER_DIGITS, "#") Then

                    currentNumber = CLng(numberPart)

                    If currentNumber > _
                        GetExistingMaxIdNumber Then

                        GetExistingMaxIdNumber = _
                            currentNumber
                    End If
                End If
            End If
        End If
    Next rowNumber
End Function

Private Function GetSavedNextIdNumber( _
    ByVal counterKey As String _
) As Long

    Dim systemSheet As Worksheet
    Dim foundCell As Range
    Dim rawValue As Variant

    GetSavedNextIdNumber = 1

    Set systemSheet = _
        ThisWorkbook.Worksheets(SHEET_SYSTEM)

    Set foundCell = _
        systemSheet.Columns(COL_SYSTEM_KEY).Find( _
            What:=counterKey, _
            After:=systemSheet.Cells( _
                1, COL_SYSTEM_KEY), _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False)

    If foundCell Is Nothing Then
        Exit Function
    End If

    rawValue = systemSheet.Cells( _
        foundCell.Row, _
        COL_SYSTEM_VALUE).Value

    If IsNumeric(rawValue) Then
        If CDbl(rawValue) = Fix(CDbl(rawValue)) Then
            If CDbl(rawValue) >= 1 _
                And CDbl(rawValue) <= _
                    ID_NUMBER_MAX + 1# Then

                GetSavedNextIdNumber = _
                    CLng(rawValue)
            End If
        End If
    End If
End Function

Private Sub SaveNextIdNumber( _
    ByVal counterKey As String, _
    ByVal nextNumber As Long _
)

    Dim systemSheet As Worksheet
    Dim foundCell As Range
    Dim targetRow As Long

    Set systemSheet = _
        ThisWorkbook.Worksheets(SHEET_SYSTEM)

    Set foundCell = _
        systemSheet.Columns(COL_SYSTEM_KEY).Find( _
            What:=counterKey, _
            After:=systemSheet.Cells( _
                1, COL_SYSTEM_KEY), _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False)

    If foundCell Is Nothing Then
        targetRow = GetNextDataRow( _
            systemSheet, _
            COL_SYSTEM_KEY, _
            DATA_FIRST_ROW)

        systemSheet.Cells( _
            targetRow, _
            COL_SYSTEM_KEY).Value = counterKey
    Else
        targetRow = foundCell.Row
    End If

    systemSheet.Cells( _
        targetRow, _
        COL_SYSTEM_VALUE).Value = nextNumber
End Sub
