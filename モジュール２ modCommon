Option Explicit

' 共通で使う小さな処理をここにまとめる

Public Sub CaptureExcelState(ByRef savedState As TExcelState)
    With Application
        savedState.ScreenUpdating = .ScreenUpdating
        savedState.EnableEvents = .EnableEvents
        savedState.Calculation = .Calculation
        savedState.DisplayAlerts = .DisplayAlerts
    End With
End Sub

Public Sub RestoreExcelState(ByRef savedState As TExcelState)
    On Error Resume Next

    With Application
        .ScreenUpdating = savedState.ScreenUpdating
        .EnableEvents = savedState.EnableEvents
        .Calculation = savedState.Calculation
        .DisplayAlerts = savedState.DisplayAlerts
    End With

    On Error GoTo 0
End Sub

Public Function WorksheetExists(ByVal sheetName As String) As Boolean
    Dim targetSheet As Object

    On Error Resume Next
    Set targetSheet = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    WorksheetExists = Not targetSheet Is Nothing
End Function

Public Function GetLastDataRow( _
    ByVal targetSheet As Worksheet, _
    Optional ByVal keyColumn As Long = 0, _
    Optional ByVal firstDataRow As Long = DATA_FIRST_ROW _
) As Long

    Dim foundCell As Range
    Dim lastRow As Long

    If keyColumn > 0 Then
        lastRow = targetSheet.Cells( _
            targetSheet.Rows.Count, keyColumn).End(xlUp).Row
    Else
        Set foundCell = targetSheet.Cells.Find( _
            What:="*", _
            After:=targetSheet.Cells(1, 1), _
            LookIn:=xlFormulas, _
            LookAt:=xlPart, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlPrevious, _
            MatchCase:=False)

        If foundCell Is Nothing Then
            lastRow = firstDataRow - 1
        Else
            lastRow = foundCell.Row
        End If
    End If

    If lastRow < firstDataRow Then
        GetLastDataRow = firstDataRow - 1
    Else
        GetLastDataRow = lastRow
    End If
End Function

Public Function GetNextDataRow( _
    ByVal targetSheet As Worksheet, _
    Optional ByVal keyColumn As Long = 0, _
    Optional ByVal firstDataRow As Long = DATA_FIRST_ROW _
) As Long

    Dim lastRow As Long

    lastRow = GetLastDataRow( _
        targetSheet, keyColumn, firstDataRow)

    If lastRow < firstDataRow Then
        GetNextDataRow = firstDataRow
    Else
        GetNextDataRow = lastRow + 1
    End If
End Function

Public Function GetSafeCellValue( _
    ByVal targetCell As Range _
) As Variant

    If targetCell Is Nothing Then
        GetSafeCellValue = Empty
    ElseIf IsError(targetCell.Value) Then
        GetSafeCellValue = Empty
    Else
        GetSafeCellValue = targetCell.Value
    End If
End Function

Public Function IsValidExcelDate( _
    ByVal targetValue As Variant _
) As Boolean

    Dim convertedDate As Date

    If IsError(targetValue) Then Exit Function
    If IsEmpty(targetValue) Then Exit Function
    If VarType(targetValue) = vbBoolean Then Exit Function
    If Len(Trim$(CStr(targetValue))) = 0 Then Exit Function
    If Not IsDate(targetValue) Then Exit Function

    On Error GoTo InvalidDate

    convertedDate = CDate(targetValue)

    If Year(convertedDate) < 1900 Then Exit Function
    If Year(convertedDate) > 9999 Then Exit Function

    IsValidExcelDate = True
    Exit Function

InvalidDate:
    IsValidExcelDate = False
End Function

Public Function DateOnlyValue( _
    ByVal targetValue As Variant _
) As Date

    If Not IsValidExcelDate(targetValue) Then
        Err.Raise _
            vbObjectError + 1000, _
            "DateOnlyValue", _
            "日付として認識できない値です。"
    End If

    DateOnlyValue = DateValue(CDate(targetValue))
End Function

Public Function GetSettingLong( _
    ByVal settingName As String, _
    ByVal defaultValue As Long, _
    Optional ByVal minimumValue As Long = 0, _
    Optional ByVal maximumValue As Long = 0, _
    Optional ByVal showWarning As Boolean = True _
) As Long

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim numericValue As Double
    Dim isValid As Boolean

    rawValue = GetSettingRawValue( _
        settingName, settingFound)

    If settingFound _
        And Not IsError(rawValue) _
        And IsNumeric(rawValue) Then

        numericValue = CDbl(rawValue)
        isValid = (numericValue = Fix(numericValue))

        If isValid _
            And numericValue >= -2147483648# _
            And numericValue <= 2147483647# Then

            If numericValue < minimumValue Then
                isValid = False
            End If

            If maximumValue > 0 _
                And numericValue > maximumValue Then

                isValid = False
            End If
        Else
            isValid = False
        End If
    End If

    If isValid Then
        GetSettingLong = CLng(numericValue)
    Else
        GetSettingLong = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning _
                settingName, CStr(defaultValue)
        End If
    End If
End Function

Public Function GetSettingBoolean( _
    ByVal settingName As String, _
    ByVal defaultValue As Boolean, _
    Optional ByVal showWarning As Boolean = True _
) As Boolean

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim normalizedValue As String
    Dim isValid As Boolean

    rawValue = GetSettingRawValue( _
        settingName, settingFound)

    If settingFound And Not IsError(rawValue) Then
        If VarType(rawValue) = vbBoolean Then
            GetSettingBoolean = CBool(rawValue)
            Exit Function
        End If

        normalizedValue = UCase$(Trim$(CStr(rawValue)))

        Select Case normalizedValue
            Case "はい", "TRUE", "1", "表示"
                GetSettingBoolean = True
                isValid = True

            Case "いいえ", "FALSE", "0", "非表示"
                GetSettingBoolean = False
                isValid = True
        End Select
    End If

    If Not isValid Then
        GetSettingBoolean = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning _
                settingName, _
                IIf(defaultValue, "はい", "いいえ")
        End If
    End If
End Function

Public Function GetSettingText( _
    ByVal settingName As String, _
    ByVal defaultValue As String, _
    Optional ByVal showWarning As Boolean = True _
) As String

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim normalizedValue As String

    rawValue = GetSettingRawValue( _
        settingName, settingFound)

    If settingFound And Not IsError(rawValue) Then
        normalizedValue = Trim$(CStr(rawValue))
    End If

    If Len(normalizedValue) > 0 Then
        GetSettingText = normalizedValue
    Else
        GetSettingText = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning _
                settingName, defaultValue
        End If
    End If
End Function

Public Function GetDateDropdownEndDate( _
    ByVal startDate As Date _
) As Date

    Dim monthCount As Long

    monthCount = GetSettingLong( _
        SETTING_DATE_DROPDOWN_MONTHS, _
        DEFAULT_DATE_DROPDOWN_MONTHS, _
        1)

    On Error GoTo DateError

    GetDateDropdownEndDate = DateAdd( _
        "m", monthCount, DateValue(startDate))

    Exit Function

DateError:
    Err.Raise _
        vbObjectError + 1001, _
        "GetDateDropdownEndDate", _
        "日付プルダウンの終了日を計算できません。"
End Function

Public Function GetPrioritySortValue( _
    ByVal priorityValue As Variant _
) As Long

    Dim normalizedValue As String

    If IsError(priorityValue) _
        Or IsEmpty(priorityValue) Then

        GetPrioritySortValue = PRIORITY_SORT_BLANK
        Exit Function
    End If

    normalizedValue = Trim$(CStr(priorityValue))

    Select Case normalizedValue
        Case PRIORITY_HIGH
            GetPrioritySortValue = PRIORITY_SORT_HIGH

        Case PRIORITY_MEDIUM
            GetPrioritySortValue = PRIORITY_SORT_MEDIUM

        Case PRIORITY_LOW
            GetPrioritySortValue = PRIORITY_SORT_LOW

        Case vbNullString
            GetPrioritySortValue = PRIORITY_SORT_BLANK

        Case Else
            GetPrioritySortValue = PRIORITY_SORT_INVALID
    End Select
End Function

Public Function GetTodoDataCount() As Long
    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long

    If Not WorksheetExists(SHEET_TODO_LIST) Then
        Exit Function
    End If

    Set targetSheet = _
        ThisWorkbook.Worksheets(SHEET_TODO_LIST)

    lastRow = GetLastDataRow(targetSheet)

    For rowNumber = DATA_FIRST_ROW To lastRow
        If Application.CountA( _
            targetSheet.Range( _
                targetSheet.Cells( _
                    rowNumber, COL_TODO_FIRST), _
                targetSheet.Cells( _
                    rowNumber, COL_TODO_LAST))) > 0 Then

            GetTodoDataCount = _
                GetTodoDataCount + 1
        End If
    Next rowNumber
End Function

Public Function CanAddTodoRows( _
    ByVal requiredCount As Long, _
    Optional ByVal showWarning As Boolean = True _
) As Boolean

    Dim todoLimit As Long
    Dim currentCount As Long

    If requiredCount <= 0 Then
        CanAddTodoRows = True
        Exit Function
    End If

    If Not WorksheetExists(SHEET_TODO_LIST) Then
        If showWarning Then
            MsgBox _
                MSG_SETUP_REQUIRED, _
                vbExclamation, _
                APP_TITLE
        End If

        Exit Function
    End If

    todoLimit = GetSettingLong( _
        SETTING_TODO_MAX, _
        DEFAULT_TODO_MAX, _
        1, _
        ABSOLUTE_TODO_MAX)

    currentCount = GetTodoDataCount()

    CanAddTodoRows = _
        (currentCount + requiredCount <= todoLimit)

    If Not CanAddTodoRows And showWarning Then
        MsgBox _
            MSG_TODO_LIMIT_REACHED & vbCrLf & _
            "現在：" & CStr(currentCount) & "件" & vbCrLf & _
            "上限：" & CStr(todoLimit) & "件", _
            vbExclamation, _
            APP_TITLE
    End If
End Function

