Option Explicit

' 初期設定で使う内部名だけここに置く
Private Const SYSTEM_DATE_LIST_COLUMN As Long = 5
Private Const TODO_DATE_LIST_NAME As String = "TodoDateChoices"
Private Const UI_FONT_NAME As String = "Yu Gothic UI"

Public Sub InitializeTodoSystem()
    Dim savedState As TExcelState
    Dim originalSheetName As String

    On Error GoTo ErrorHandler

    CaptureExcelState savedState
    originalSheetName = ActiveSheet.Name

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
        .DisplayAlerts = False
    End With

    CreateRequiredSheets
    SetupAllSheets

    ThisWorkbook.Worksheets(SHEET_SYSTEM).Visible = xlSheetVeryHidden
    ThisWorkbook.Worksheets(SHEET_BACKUP).Visible = xlSheetVeryHidden

    If WorksheetExists(originalSheetName) Then
        ThisWorkbook.Worksheets(originalSheetName).Activate
    Else
        ThisWorkbook.Worksheets(SHEET_TODO_ADD).Activate
    End If

    MsgBox "初期設定が完了しました。", vbInformation, APP_TITLE

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    ShowProcessError "初期設定", vbNullString, 0, _
        vbNullString, Err.Description

    Resume ExitHandler
End Sub

Public Sub CreateRequiredSheets()
    Dim sheetNames As Variant
    Dim sheetNameValue As Variant
    Dim newSheet As Worksheet

    sheetNames = Array( _
        SHEET_TODO_ADD, _
        SHEET_TODO_LIST, _
        SHEET_COMPLETED, _
        SHEET_DAILY, _
        SHEET_RECURRING, _
        SHEET_HOLIDAY, _
        SHEET_SETTINGS, _
        SHEET_SYSTEM, _
        SHEET_BACKUP)

    For Each sheetNameValue In sheetNames
        If Not WorksheetExists(CStr(sheetNameValue)) Then
            Set newSheet = ThisWorkbook.Worksheets.Add( _
                After:=ThisWorkbook.Worksheets( _
                    ThisWorkbook.Worksheets.Count))

            newSheet.Name = CStr(sheetNameValue)
        End If
    Next sheetNameValue
End Sub

Public Sub SetupAllSheets()
    SetupSystemManagementSheet
    SetupSettingsSheet
    RefreshDateChoiceList

    SetupTodoAddSheet
    SetupTodoListSheet
    SetupCompletedSheet
    SetupDailySheet
    SetupRecurringSheet
    SetupHolidaySheet
    SetupBackupSheet

    RebuildDailyUseCheckboxes
    RebuildRecurringUseCheckboxes
    SetupVisibleSheetWindows

    ThisWorkbook.Worksheets(SHEET_SYSTEM).Visible = xlSheetVeryHidden
    ThisWorkbook.Worksheets(SHEET_BACKUP).Visible = xlSheetVeryHidden
End Sub

Public Sub RefreshSystemLayout()
    Dim savedState As TExcelState
    Dim originalSheetName As String

    On Error GoTo ErrorHandler

    CaptureExcelState savedState
    originalSheetName = ActiveSheet.Name

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
        .DisplayAlerts = False
    End With

    CreateRequiredSheets
    SetupAllSheets

    If WorksheetExists(originalSheetName) Then
        ThisWorkbook.Worksheets(originalSheetName).Activate
    Else
        ThisWorkbook.Worksheets(SHEET_TODO_ADD).Activate
    End If

    MsgBox "初期設定を更新しました。", vbInformation, APP_TITLE

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    ShowProcessError "初期設定の更新", vbNullString, 0, _
        vbNullString, Err.Description

    Resume ExitHandler
End Sub

