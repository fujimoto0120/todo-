    Dim overdueCondition As FormatCondition

    Set targetRange = targetSheet.Range( _
        targetSheet.Cells( _
            DATA_FIRST_ROW, _
            COL_TODO_DUE), _
        targetSheet.Cells( _
            lastLayoutRow, _
            COL_TODO_DUE))

