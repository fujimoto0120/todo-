        .Add _
            Type:=xlValidateWholeNumber, _
            AlertStyle:=xlValidAlertStop, _
            Operator:=xlGreaterEqual, _
            Formula1:=CStr(minimumValue)

        .IgnoreBlank = True
        .ShowInput = True
        .ShowError = True
    End With
End Sub

Private Sub ApplyTodoDateConditionalFormatting( _
    ByVal targetSheet As Worksheet, _
    ByVal lastLayoutRow As Long _
)

