Private Sub ApplyListValidation( _
    ByVal targetRange As Range, _
    ByVal allowedValues As Variant _
)

    Dim separator As String
    Dim formulaText As String
    Dim index As Long

    separator = Application.International(xlListSeparator)

    For index = LBound(allowedValues) To UBound(allowedValues)
        If Len(formulaText) > 0 Then
            formulaText = formulaText & separator
        End If

        formulaText = formulaText & CStr(allowedValues(index))
    Next index

    With targetRange.Validation
        .Delete

        .Add _
            Type:=xlValidateList, _
            AlertStyle:=xlValidAlertStop, _
            Operator:=xlBetween, _
            Formula1:=formulaText

        .IgnoreBlank = True
        .InCellDropdown = True
        .ShowInput = True
        .ShowError = True
    End With
End Sub

Private Sub ApplyWholeNumberValidation( _
    ByVal targetRange As Range, _
    ByVal minimumValue As Long, _
    ByVal maximumValue As Long _
)

    With targetRange.Validation
        .Delete

        .Add _
            Type:=xlValidateWholeNumber, _
            AlertStyle:=xlValidAlertStop, _
            Operator:=xlBetween, _
            Formula1:=CStr(minimumValue), _
            Formula2:=CStr(maximumValue)

        .IgnoreBlank = True
        .ShowInput = True
        .ShowError = True
    End With
End Sub

Private Sub ApplyMinimumWholeNumberValidation( _
    ByVal targetRange As Range, _
    ByVal minimumValue As Long _
)

    With targetRange.Validation
