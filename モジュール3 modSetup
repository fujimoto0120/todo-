Private Sub RebuildUseCheckboxes( _
    ByVal targetSheet As Worksheet, _
    ByVal checkboxPrefix As String, _
    ByVal linkedColumn As Long, _
    ByVal lastRow As Long, _
    ByVal macroName As String _
)

    Dim shapeIndex As Long
    Dim rowNumber As Long
    Dim linkedCell As Range
    Dim newCheckbox As CheckBox
    Dim isEnabled As Boolean
    Dim checkboxSize As Double

    For shapeIndex = targetSheet.Shapes.Count To 1 Step -1
        If Left$( _
            targetSheet.Shapes(shapeIndex).Name, _
            Len(checkboxPrefix)) = checkboxPrefix Then

            targetSheet.Shapes(shapeIndex).Delete
        End If
    Next shapeIndex

    checkboxSize = 14

    For rowNumber = DATA_FIRST_ROW To lastRow
        Set linkedCell = targetSheet.Cells( _
            rowNumber, _
            linkedColumn)

        isEnabled = CellValueIsEnabled(linkedCell.Value)
        linkedCell.Value = isEnabled
        linkedCell.NumberFormat = ";;;"

        Set newCheckbox = targetSheet.CheckBoxes.Add( _
            linkedCell.Left + _
                (linkedCell.Width - checkboxSize) / 2, _
            linkedCell.Top + _
                (linkedCell.Height - checkboxSize) / 2, _
            checkboxSize, _
            checkboxSize)

        With newCheckbox
            .Name = checkboxPrefix & CStr(rowNumber)
            .Caption = vbNullString

            .LinkedCell = "'" & _
                Replace(targetSheet.Name, "'", "''") & _
                "'!" & linkedCell.Address

            .OnAction = macroName
            .Placement = xlMoveAndSize
            .PrintObject = False

            If isEnabled Then
                .Value = xlOn
            Else
                .Value = xlOff
            End If
        End With
    Next rowNumber
End Sub

Private Function CellValueIsEnabled( _
    ByVal targetValue As Variant _
) As Boolean

    Dim normalizedValue As String

    If IsError(targetValue) Or IsEmpty(targetValue) Then
        Exit Function
    End If

    If VarType(targetValue) = vbBoolean Then
        CellValueIsEnabled = CBool(targetValue)
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))

    CellValueIsEnabled = _
        (normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1")
End Function

