Private Sub SetHeaders( _
    ByVal targetSheet As Worksheet, _
    ByVal headers As Variant, _
    ByVal firstColumn As Long _
)

    Dim index As Long
    Dim targetColumn As Long
    Dim headerRange As Range

    For index = LBound(headers) To UBound(headers)
        targetColumn = firstColumn + index - LBound(headers)

        targetSheet.Cells( _
            HEADER_ROW, _
            targetColumn).Value = headers(index)
    Next index

    Set headerRange = targetSheet.Range( _
        targetSheet.Cells( _
            HEADER_ROW, _
            firstColumn), _
        targetSheet.Cells( _
            HEADER_ROW, _
            firstColumn + UBound(headers) - LBound(headers)))

    StyleHeaderRange headerRange
    ApplyBorders headerRange, COLOR_HEADER_TEAL
End Sub

