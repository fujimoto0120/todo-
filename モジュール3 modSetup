Private Sub RefreshDateChoiceList()
    Dim systemSheet As Worksheet
    Dim startDate As Date
    Dim endDate As Date
    Dim dayCount As Long
    Dim dateValues() As Variant
    Dim index As Long
    Dim oldLastRow As Long
    Dim newLastRow As Long
    Dim refersToText As String

    Set systemSheet = ThisWorkbook.Worksheets(SHEET_SYSTEM)

    startDate = Date
    endDate = GetDateDropdownEndDate(startDate)
    dayCount = DateDiff("d", startDate, endDate) + 1

    oldLastRow = GetLastDataRow( _
        systemSheet, _
        SYSTEM_DATE_LIST_COLUMN, _
        DATA_FIRST_ROW)

    If oldLastRow >= DATA_FIRST_ROW Then
        systemSheet.Range( _
            systemSheet.Cells( _
                DATA_FIRST_ROW, _
                SYSTEM_DATE_LIST_COLUMN), _
            systemSheet.Cells( _
                oldLastRow, _
                SYSTEM_DATE_LIST_COLUMN)).ClearContents
    End If

    ReDim dateValues(1 To dayCount, 1 To 1)

    For index = 1 To dayCount
        dateValues(index, 1) = DateAdd( _
            "d", _
            index - 1, _
            startDate)
    Next index

    newLastRow = DATA_FIRST_ROW + dayCount - 1

    With systemSheet.Range( _
        systemSheet.Cells( _
            DATA_FIRST_ROW, _
            SYSTEM_DATE_LIST_COLUMN), _
        systemSheet.Cells( _
            newLastRow, _
            SYSTEM_DATE_LIST_COLUMN))

        .Value = dateValues
        .NumberFormat = DATE_DISPLAY_FORMAT
    End With

    On Error Resume Next
    ThisWorkbook.Names(TODO_DATE_LIST_NAME).Delete
    On Error GoTo 0

    refersToText = "='" & _
        Replace(systemSheet.Name, "'", "''") & _
        "'!" & _
        systemSheet.Range( _
            systemSheet.Cells( _
                DATA_FIRST_ROW, _
                SYSTEM_DATE_LIST_COLUMN), _
            systemSheet.Cells( _
                newLastRow, _
                SYSTEM_DATE_LIST_COLUMN)).Address

    ThisWorkbook.Names.Add _
        Name:=TODO_DATE_LIST_NAME, _
        RefersTo:=refersToText, _
        Visible:=False
End Sub

