' 履歴整理
'============================================================
Public Sub CleanupHistory()
    CleanupHistoryCore True
End Sub

Private Sub CleanupHistoryCore(ByVal showMessage As Boolean)
    Dim daysToKeep As Long
    Dim cutoffDate As Date
    Dim i As Long
    Dim deleteCount As Long
    Dim lo As ListObject

    Set lo = HistoryTable

    If IsNumeric( _
        ThisWorkbook.Worksheets(S_SETTINGS).Range("B5").Value) Then

        daysToKeep = CLng( _
            ThisWorkbook.Worksheets(S_SETTINGS).Range("B5").Value)
    Else
        daysToKeep = 90
    End If

    If daysToKeep < 1 Then daysToKeep = 1

    cutoffDate = DateAdd("d", -daysToKeep, Date)

    For i = lo.ListRows.Count To 1 Step -1
        If IsDate(lo.ListRows(i).Range.Cells(1, 3).Value) Then
            If CDate(lo.ListRows(i).Range.Cells(1, 3).Value) < _
               cutoffDate Then

                deleteCount = deleteCount + 1
            End If
        End If
    Next i

    If deleteCount = 0 Then
        If showMessage Then
            MsgBox "整理対象の履歴はありません。", vbInformation
        End If
        Exit Sub
    End If

    If showMessage Then
        If MsgBox( _
            deleteCount & _
            "件の履歴を完全に削除します。元には戻せません。続けますか？", _
            vbExclamation + vbYesNo) <> vbYes Then
            Exit Sub
        End If
    End If

    For i = lo.ListRows.Count To 1 Step -1
        If IsDate(lo.ListRows(i).Range.Cells(1, 3).Value) Then
            If CDate(lo.ListRows(i).Range.Cells(1, 3).Value) < _
               cutoffDate Then

                lo.ListRows(i).Delete
            End If
        End If
    Next i

    EnsureBlankRow lo

    If showMessage Then
        MsgBox deleteCount & "件の履歴を削除しました。", vbInformation
    End If
End Sub

'============================================================
' 繰り返し納期計算
'============================================================
Private Function NextDueDate( _
    ByVal scheduledDue As Date, _
    ByVal completedOn As Date, _
    ByVal repeatType As String, _
    ByVal intervalValue As Long, _
    ByVal baseText As String, _
    ByVal weekdayText As String, _
    ByVal dayValue As Long, _
    ByVal ordinalText As String) As Date

    Dim baseDate As Date
    Dim monthDate As Date

    If intervalValue < 1 Then intervalValue = 1

    If baseText = "完了日" Then
        baseDate = DateValue(completedOn)
    Else
        baseDate = DateValue(scheduledDue)
    End If

    Select Case repeatType

        Case REC_DAILY
            NextDueDate = DateAdd("d", intervalValue, baseDate)

        Case REC_WEEKDAY
            NextDueDate = AddBusinessDays(baseDate, intervalValue)

        Case REC_WEEKLY
            NextDueDate = NextWeekday( _
                baseDate, WeekdayNumber(weekdayText), intervalValue)

        Case REC_MONTH_DAY
            monthDate = DateSerial( _
                Year(baseDate), Month(baseDate) + intervalValue, 1)

            NextDueDate = SafeMonthDate( _
                Year(monthDate), Month(monthDate), dayValue)

        Case REC_MONTH_ORDINAL
            monthDate = DateSerial( _
                Year(baseDate), Month(baseDate) + intervalValue, 1)

            NextDueDate = NthWeekday( _
                Year(monthDate), _
                Month(monthDate), _
                WeekdayNumber(weekdayText), _
                OrdinalNumber(ordinalText))

        Case REC_MONTH_END
            NextDueDate = DateSerial( _
                Year(baseDate), _
                Month(baseDate) + intervalValue + 1, _
                0)

        Case REC_BUSINESS_MONTH_END
            NextDueDate = PreviousBusinessDay( _
                DateSerial( _
                    Year(baseDate), _
                    Month(baseDate) + intervalValue + 1, _
                    0))
    End Select
End Function

Private Function NextWeekday( _
    ByVal baseDate As Date, _
    ByVal targetWeekday As Long, _
    ByVal intervalValue As Long) As Date

    Dim gap As Long

    gap = (targetWeekday - Weekday(baseDate, vbMonday) + 7) Mod 7

    If gap = 0 Then
        gap = 7 * intervalValue
    Else
        gap = gap + 7 * (intervalValue - 1)
    End If

    NextWeekday = DateAdd("d", gap, baseDate)
End Function

Private Function SafeMonthDate( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long, _
    ByVal targetDay As Long) As Date

    Dim lastDay As Long

    If targetDay < 1 Then targetDay = 1
    If targetDay > 31 Then targetDay = 31

    lastDay = Day(DateSerial(targetYear, targetMonth + 1, 0))

    If targetDay > lastDay Then
        targetDay = lastDay
    End If

    SafeMonthDate = DateSerial( _
        targetYear, targetMonth, targetDay)
End Function

Private Function NthWeekday( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long, _
    ByVal targetWeekday As Long, _
    ByVal ordinal As Long) As Date

    Dim firstDate As Date
    Dim lastDate As Date
    Dim resultDate As Date
    Dim gap As Long

    If ordinal = 0 Then
        lastDate = DateSerial(targetYear, targetMonth + 1, 0)

        gap = (Weekday(lastDate, vbMonday) - _
               targetWeekday + 7) Mod 7

        NthWeekday = DateAdd("d", -gap, lastDate)
    Else
        firstDate = DateSerial(targetYear, targetMonth, 1)

        gap = (targetWeekday - _
               Weekday(firstDate, vbMonday) + 7) Mod 7

        resultDate = DateAdd( _
            "d", gap + 7 * (ordinal - 1), firstDate)

        If Month(resultDate) = targetMonth Then
            NthWeekday = resultDate
        End If
    End If
End Function

Private Function AddBusinessDays( _
    ByVal startDate As Date, _
    ByVal numberOfDays As Long) As Date

    Dim resultDate As Date
    Dim added As Long

    resultDate = DateValue(startDate)

    Do While added < numberOfDays
        resultDate = DateAdd("d", 1, resultDate)

        If IsBusinessDay(resultDate) Then
            added = added + 1
        End If
    Loop

    AddBusinessDays = resultDate
End Function

Private Function PreviousBusinessDay( _
    ByVal startDate As Date) As Date

    Dim resultDate As Date

    resultDate = DateValue(startDate)

    Do While Not IsBusinessDay(resultDate)
        resultDate = DateAdd("d", -1, resultDate)
    Loop

    PreviousBusinessDay = resultDate
End Function

Private Function IsBusinessDay( _
    ByVal checkDate As Date) As Boolean

    If Weekday(checkDate, vbMonday) > 5 Then Exit Function
    If IsHoliday(checkDate) Then Exit Function

    IsBusinessDay = True
End Function

Private Function IsHoliday( _
    ByVal checkDate As Date) As Boolean

    Dim cell As Range

    On Error GoTo ExitPoint

    For Each cell In _
        ThisWorkbook.Worksheets(S_SETTINGS).Range("A10:A300").Cells

        If IsDate(cell.Value) Then
            If CLng(DateValue(cell.Value)) = _
               CLng(DateValue(checkDate)) Then

                IsHoliday = True
                Exit Function
            End If
        End If
    Next cell

ExitPoint:
End Function

Private Function WeekdayNumber(ByVal text As String) As Long
    Select Case Trim$(text)
        Case "月": WeekdayNumber = 1
        Case "火": WeekdayNumber = 2
        Case "水": WeekdayNumber = 3
        Case "木": WeekdayNumber = 4
        Case "金": WeekdayNumber = 5
        Case "土": WeekdayNumber = 6
        Case "日": WeekdayNumber = 7
        Case Else: WeekdayNumber = 1
    End Select
End Function

Private Function OrdinalNumber(ByVal text As String) As Long
    Select Case Trim$(text)
        Case "第1": OrdinalNumber = 1
        Case "第2": OrdinalNumber = 2
        Case "第3": OrdinalNumber = 3
        Case "第4": OrdinalNumber = 4
        Case "最終": OrdinalNumber = 0
        Case Else: OrdinalNumber = 1
    End Select
End Function

