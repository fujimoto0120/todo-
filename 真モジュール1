    Set ws = ThisWorkbook.Worksheets(S_ENTRY)

    ws.Range("C3").ClearContents
    ws.Range("C5").Value = Date
    ws.Range("F5").Formula = "=C5"
    ws.Range("C7").ClearContents
    ws.Range("F7").Value = "中"
    ws.Range("C9").Value = "業務"
    ws.Range("F9").Value = "未着手"
    ws.Range("C11").ClearContents
    ws.Range("C15").Value = REC_NONE
    ws.Range("F15").Value = 1
    ws.Range("C17").Value = "元の納期"
    ws.Range("F17").Value = "月"
    ws.Range("C19").Value = 1
    ws.Range("F19").Value = "第1"
    ws.Range("C21").ClearContents

    If showMessage Then
        MsgBox "入力欄をクリアしました。", vbInformation
    End If
End Sub

Private Function ValidateRepeatInput( _
    ByVal repeatType As String, _
    ByVal intervalValue As Long, _
    ByVal weekdayText As String, _
    ByVal dayValue As Long, _
    ByVal ordinalText As String, _
    ByVal endValue As Variant, _
    ByVal firstDue As Date) As Boolean

    If repeatType = REC_NONE Then
        ValidateRepeatInput = True
        Exit Function
    End If

    If intervalValue < 1 Or intervalValue > 99 Then
        MsgBox "間隔は1～99で入力してください。", vbExclamation
        Exit Function
    End If

    If repeatType = REC_WEEKLY Or _
       repeatType = REC_MONTH_ORDINAL Then

        If Len(weekdayText) <> 1 Or _
           InStr("月火水木金土日", weekdayText) = 0 Then

            MsgBox "曜日を選択してください。", vbExclamation
            Exit Function
        End If
    End If

    If repeatType = REC_MONTH_DAY Then
        If dayValue < 1 Or dayValue > 31 Then
            MsgBox "日付は1～31で入力してください。", vbExclamation
            Exit Function
        End If
    End If

    If repeatType = REC_MONTH_ORDINAL Then
        Select Case ordinalText
            Case "第1", "第2", "第3", "第4", "最終"
            Case Else
                MsgBox "第何週を選択してください。", vbExclamation
                Exit Function
        End Select
    End If

    If Trim$(CStr(endValue)) <> "" Then
        If Not IsDate(endValue) Then
            MsgBox "繰返し終了日を日付で入力してください。", vbExclamation
            Exit Function
        End If

        If DateValue(endValue) < firstDue Then
            MsgBox "繰返し終了日は最初の納期以降にしてください。", vbExclamation
            Exit Function
        End If
    End If

    ValidateRepeatInput = True
End Function

'============================================================
' 完了・削除・復元
'============================================================
Public Sub CompleteSelectedTask()
    Dim lr As ListRow

    Set lr = SelectedListRow(TodoTable)

    If lr Is Nothing Then
        MsgBox "完了するタスクの行を選択してください。", vbExclamation
        Exit Sub
    End If

    CompleteRow lr
End Sub

Public Sub CompleteTaskFromCell(ByVal target As Range)
    Dim lr As ListRow

    Set lr = ListRowFromCell(TodoTable, target)

    If Not lr Is Nothing Then
        CompleteRow lr
    End If
End Sub

Public Function IsDoneCell( _
    ByVal Sh As Object, _
    ByVal target As Range) As Boolean

    Dim lo As ListObject

    On Error GoTo ExitPoint

    If Sh.Name <> S_TODO Then Exit Function
    If target.CountLarge <> 1 Then Exit Function

    Set lo = TodoTable

    If lo.DataBodyRange Is Nothing Then Exit Function

    IsDoneCell = Not Intersect( _
        target, lo.ListColumns(C_DONE).DataBodyRange) Is Nothing

ExitPoint:
End Function

Private Sub CompleteRow(ByVal lr As ListRow)
    Dim taskText As String
    Dim successorId As String

    taskText = Trim$(CStr(lr.Range.Cells(1, C_TASK).Value))
    If taskText = "" Then Exit Sub

    If MsgBox( _
        "次のタスクを完了にしますか？" & vbCrLf & vbCrLf & taskText, _
        vbQuestion + vbYesNo) <> vbYes Then
        Exit Sub
    End If

    On Error GoTo ErrorHandler
    Application.EnableEvents = False

    successorId = CreateSuccessor(lr)

    ArchiveRow lr, "完了", successorId
    lr.Delete

    EnsureBlankRow TodoTable
    SortTasks False

    Application.EnableEvents = True

    If successorId = "" Then
        MsgBox "完了履歴へ移動しました。", vbInformation
    Else
        MsgBox "完了履歴へ移動し、次回タスクを追加しました。", vbInformation
    End If

    Exit Sub

ErrorHandler:
    Application.EnableEvents = True

    MsgBox "完了処理中にエラーが発生しました。" & vbCrLf & _
           Err.Description, vbExclamation
End Sub

Public Sub DeleteSelectedTask()
    Dim lr As ListRow
    Dim taskText As String

    Set lr = SelectedListRow(TodoTable)

    If lr Is Nothing Then
        MsgBox "削除するタスクの行を選択してください。", vbExclamation
        Exit Sub
    End If

    taskText = Trim$(CStr(lr.Range.Cells(1, C_TASK).Value))
    If taskText = "" Then Exit Sub

    If MsgBox( _
        "次のタスクを削除しますか？" & vbCrLf & vbCrLf & _
        taskText & vbCrLf & vbCrLf & _
        "削除後も履歴から復元できます。", _
        vbQuestion + vbYesNo) <> vbYes Then
        Exit Sub
    End If

    On Error GoTo ErrorHandler
    Application.EnableEvents = False

    ArchiveRow lr, "削除", ""
    lr.Delete

    EnsureBlankRow TodoTable
    SortTasks False

    Application.EnableEvents = True

    MsgBox "削除履歴へ移動しました。", vbInformation
    Exit Sub

ErrorHandler:
    Application.EnableEvents = True

    MsgBox "削除処理中にエラーが発生しました。" & vbCrLf & _
           Err.Description, vbExclamation
End Sub

Public Sub RestoreSelectedTask()
    Dim hr As ListRow
    Dim tr As ListRow
    Dim successor As ListRow
    Dim existingTask As ListRow
    Dim taskId As String
    Dim successorId As String
    Dim i As Long
    Dim answer As VbMsgBoxResult

    Set hr = SelectedListRow(HistoryTable)

    If hr Is Nothing Then
        MsgBox "復元する履歴の行を選択してください。", vbExclamation
        Exit Sub
    End If

    If Trim$(CStr(hr.Range.Cells(1, 9).Value)) = "" Then
        MsgBox "復元する履歴の行を選択してください。", vbExclamation
        Exit Sub
    End If

    taskId = CStr(hr.Range.Cells(1, 13).Value)

    Set existingTask = FindTodoById(taskId)

    If Not existingTask Is Nothing Then
        MsgBox "同じタスクIDがすでにToDoにあるため復元できません。", vbExclamation
        Exit Sub
    End If

    successorId = CStr(hr.Range.Cells(1, 25).Value)

    If successorId <> "" Then
        Set successor = FindTodoById(successorId)
    End If

    If Not successor Is Nothing Then
        answer = MsgBox( _
            "この完了時に作られた次回タスクが残っています。" & vbCrLf & _
            "次回タスクも削除しますか？", _
            vbQuestion + vbYesNoCancel)

        If answer = vbCancel Then Exit Sub
    End If

    If MsgBox( _
        "「" & CStr(hr.Range.Cells(1, 9).Value) & _
        "」をToDoへ復元しますか？", _
        vbQuestion + vbYesNo) <> vbYes Then
        Exit Sub
    End If

    On Error GoTo ErrorHandler
    Application.EnableEvents = False

    If answer = vbYes And Not successor Is Nothing Then
        successor.Delete
    End If

    Set tr = WritableRow(TodoTable)

    For i = 1 To 21
        tr.Range.Cells(1, i).Value = _
            hr.Range.Cells(1, i + 3).Value
    Next i

    tr.Range.Cells(1, C_DONE).Value = "□"

    hr.Delete

    EnsureBlankRow TodoTable
    EnsureBlankRow HistoryTable

    SortTasks False

    ThisWorkbook.Worksheets(S_TODO).Activate

    Application.EnableEvents = True

    MsgBox "ToDoへ復元しました。", vbInformation
    Exit Sub

ErrorHandler:
    Application.EnableEvents = True

    MsgBox "復元処理中にエラーが発生しました。" & vbCrLf & _
           Err.Description, vbExclamation
End Sub

Private Sub ArchiveRow( _
    ByVal sourceRow As ListRow, _
    ByVal actionText As String, _
    ByVal successorId As String)

    Dim hr As ListRow
    Dim i As Long

    Set hr = WritableRow(HistoryTable)

    hr.Range.Cells(1, 1).Value = "戻す"
    hr.Range.Cells(1, 2).Value = actionText
    hr.Range.Cells(1, 3).Value = Now

    For i = 1 To 21
        hr.Range.Cells(1, i + 3).Value = _
            sourceRow.Range.Cells(1, i).Value
    Next i

    hr.Range.Cells(1, 25).Value = successorId
End Sub

Private Function CreateSuccessor( _
    ByVal sourceRow As ListRow) As String

    Dim repeatType As String
    Dim seriesId As String
    Dim existingId As String
    Dim intervalValue As Long
    Dim dayValue As Long
    Dim dueOffset As Long
    Dim nextDue As Date
    Dim actualDue As Date
    Dim endValue As Variant

    repeatType = Trim$(CStr( _
        sourceRow.Range.Cells(1, C_REPEAT).Value))

    If repeatType = "" Or repeatType = REC_NONE Then Exit Function

    If IsNumeric(sourceRow.Range.Cells(1, C_INTERVAL).Value) Then
        intervalValue = CLng( _
            sourceRow.Range.Cells(1, C_INTERVAL).Value)
    Else
        intervalValue = 1
    End If

    If IsNumeric(sourceRow.Range.Cells(1, C_DAY).Value) Then
        dayValue = CLng(sourceRow.Range.Cells(1, C_DAY).Value)
    Else
        dayValue = 1
    End If

    If IsNumeric(sourceRow.Range.Cells(1, C_DUE_OFFSET).Value) Then
        dueOffset = CLng( _
            sourceRow.Range.Cells(1, C_DUE_OFFSET).Value)
    End If

    If dueOffset < 0 Then dueOffset = 0

    nextDue = NextDueDate( _
        DateValue(sourceRow.Range.Cells(1, C_SELF_DUE).Value), _
        Date, _
        repeatType, _
        intervalValue, _
        CStr(sourceRow.Range.Cells(1, C_BASE).Value), _
        CStr(sourceRow.Range.Cells(1, C_WEEKDAY).Value), _
        dayValue, _
        CStr(sourceRow.Range.Cells(1, C_ORDINAL).Value))

    If nextDue = 0 Then Exit Function

    endValue = sourceRow.Range.Cells(1, C_END_DATE).Value

    If IsDate(endValue) Then
        If nextDue > DateValue(endValue) Then Exit Function
    End If

    seriesId = CStr( _
        sourceRow.Range.Cells(1, C_SERIES_ID).Value)

    If seriesId = "" Then
        seriesId = NewId("R")
        sourceRow.Range.Cells(1, C_SERIES_ID).Value = seriesId
    End If

    existingId = ExistingSeriesDueId(seriesId, nextDue)

    If existingId <> "" Then
        CreateSuccessor = existingId
        Exit Function
    End If

    actualDue = DateAdd("d", dueOffset, nextDue)

    CreateSuccessor = AppendTask( _
        CStr(sourceRow.Range.Cells(1, C_TASK).Value), _
        nextDue, _
        actualDue, _
        CStr(sourceRow.Range.Cells(1, C_NUMBER).Value), _
        CStr(sourceRow.Range.Cells(1, C_PRIORITY).Value), _
        CStr(sourceRow.Range.Cells(1, C_CATEGORY).Value), _
        "未着手", _
        repeatType, _
        seriesId, _
        CStr(sourceRow.Range.Cells(1, C_MEMO).Value), _
        intervalValue, _
        CStr(sourceRow.Range.Cells(1, C_BASE).Value), _
        CStr(sourceRow.Range.Cells(1, C_WEEKDAY).Value), _
        dayValue, _
        CStr(sourceRow.Range.Cells(1, C_ORDINAL).Value), _
        endValue, _
        dueOffset)
End Function

'============================================================
' テーブル追加・検証・並べ替え
'============================================================
Private Function AppendTask( _
    ByVal taskText As String, _
    ByVal selfDue As Date, _
    ByVal actualDue As Date, _
    ByVal numberText As String, _
    ByVal priorityText As String, _
    ByVal categoryText As String, _
    ByVal statusText As String, _
    ByVal repeatType As String, _
    ByVal seriesId As String, _
    ByVal memoText As String, _
    ByVal intervalValue As Long, _
    ByVal baseText As String, _
    ByVal weekdayText As String, _
    ByVal dayValue As Long, _
    ByVal ordinalText As String, _
    ByVal endValue As Variant, _
    ByVal dueOffset As Long, _
    Optional ByVal requestedTaskId As String = "", _
    Optional ByVal createdAt As Variant) As String

    Dim lr As ListRow
    Dim taskId As String

    Set lr = WritableRow(TodoTable)

    If requestedTaskId = "" Then
        taskId = NewId("T")
    Else
        taskId = requestedTaskId
    End If

    With lr.Range
        .Cells(1, C_DONE).Value = "□"
        .Cells(1, C_PRIORITY).Value = priorityText
        .Cells(1, C_SELF_DUE).Value = DateValue(selfDue)
        .Cells(1, C_ACTUAL_DUE).Value = DateValue(actualDue)
        .Cells(1, C_NUMBER).Value = numberText
        .Cells(1, C_TASK).Value = taskText
        .Cells(1, C_STATUS).Value = statusText
        .Cells(1, C_CATEGORY).Value = categoryText
        .Cells(1, C_REPEAT).Value = repeatType
        .Cells(1, C_TASK_ID).Value = taskId
        .Cells(1, C_SERIES_ID).Value = seriesId

        If IsDate(createdAt) Then
            .Cells(1, C_CREATED).Value = CDate(createdAt)
        Else
            .Cells(1, C_CREATED).Value = Now
        End If

        .Cells(1, C_MEMO).Value = memoText
        .Cells(1, C_INTERVAL).Value = intervalValue
        .Cells(1, C_BASE).Value = baseText
        .Cells(1, C_WEEKDAY).Value = weekdayText
        .Cells(1, C_DAY).Value = dayValue
        .Cells(1, C_ORDINAL).Value = ordinalText

        If IsDate(endValue) Then
            .Cells(1, C_END_DATE).Value = DateValue(endValue)
        End If

        .Cells(1, C_DUE_OFFSET).Value = dueOffset
    End With

    AppendTask = taskId
End Function

Public Sub ValidateAndSortTasks()
    Dim lr As ListRow

    For Each lr In TodoTable.ListRows
        If Trim$(CStr(lr.Range.Cells(1, C_TASK).Value)) <> "" Then

            If Not IsDate(lr.Range.Cells(1, C_SELF_DUE).Value) Or _
               Not IsDate(lr.Range.Cells(1, C_ACTUAL_DUE).Value) Then

                MsgBox "納期が日付ではない行があります。", vbExclamation
                lr.Range.Select
                Exit Sub
            End If

            If DateValue(lr.Range.Cells(1, C_ACTUAL_DUE).Value) < _
               DateValue(lr.Range.Cells(1, C_SELF_DUE).Value) Then

                MsgBox "実納期が自分納期より前の行があります。", vbExclamation
                lr.Range.Cells(1, C_ACTUAL_DUE).Select
                Exit Sub
            End If

            If CStr(lr.Range.Cells(1, C_TASK_ID).Value) = "" Then
                lr.Range.Cells(1, C_TASK_ID).Value = NewId("T")
            End If

            If CStr(lr.Range.Cells(1, C_DONE).Value) = "" Then
                lr.Range.Cells(1, C_DONE).Value = "□"
            End If
        End If
    Next lr

    SortTasks False

    MsgBox "入力内容を確認し、納期順に並べ替えました。", vbInformation
End Sub

Public Sub SortTasks( _
    Optional ByVal showMessage As Boolean = True)

    Dim lo As ListObject

    On Error GoTo ExitPoint

    Set lo = TodoTable

    With lo.Sort
        .SortFields.Clear

        .SortFields.Add _
            Key:=lo.ListColumns(C_SELF_DUE).Range, _
            Order:=xlAscending

        .SortFields.Add _
            Key:=lo.ListColumns(C_PRIORITY).Range, _
            Order:=xlAscending, _
            CustomOrder:="高,中,低"

        .Header = xlYes
        .Apply
    End With

    If showMessage Then
        MsgBox "納期順に並べ替えました。", vbInformation
    End If

ExitPoint:
End Sub

