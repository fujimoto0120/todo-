Private Function TodoTable() As ListObject
    Set TodoTable = _
        ThisWorkbook.Worksheets(S_TODO).ListObjects(T_TODO)
End Function

Private Function HistoryTable() As ListObject
    Set HistoryTable = _
        ThisWorkbook.Worksheets(S_HISTORY).ListObjects(T_HISTORY)
End Function

Private Function WritableRow( _
    ByVal lo As ListObject) As ListRow

    Dim lr As ListRow

    If lo.ListRows.Count = 0 Then
        Set WritableRow = lo.ListRows.Add
        Exit Function
    End If

    For Each lr In lo.ListRows
        If Application.WorksheetFunction.CountA(lr.Range) = 0 Then
            Set WritableRow = lr
            Exit Function
        End If
    Next lr

    Set WritableRow = lo.ListRows.Add
End Function

Private Sub EnsureBlankRow(ByVal lo As ListObject)
    If lo.ListRows.Count = 0 Then
        lo.ListRows.Add
    End If
End Sub

Private Function SelectedListRow( _
    ByVal lo As ListObject) As ListRow

    Set SelectedListRow = ListRowFromCell(lo, ActiveCell)
End Function

Private Function ListRowFromCell( _
    ByVal lo As ListObject, _
    ByVal target As Range) As ListRow

    Dim hit As Range
    Dim rowIndex As Long

    If lo.DataBodyRange Is Nothing Then Exit Function

    Set hit = Intersect(target, lo.DataBodyRange)

    If hit Is Nothing Then Exit Function

    rowIndex = hit.Row - lo.DataBodyRange.Row + 1

    Set ListRowFromCell = lo.ListRows(rowIndex)
End Function

Private Function FindTodoById( _
    ByVal taskId As String) As ListRow

    Dim lr As ListRow

    If taskId = "" Then Exit Function

    For Each lr In TodoTable.ListRows
        If CStr(lr.Range.Cells(1, C_TASK_ID).Value) = taskId Then
            Set FindTodoById = lr
            Exit Function
        End If
    Next lr
End Function

Private Function ExistingSeriesDueId( _
    ByVal seriesId As String, _
    ByVal dueDate As Date) As String

    Dim lr As ListRow

    For Each lr In TodoTable.ListRows
        If CStr(lr.Range.Cells(1, C_SERIES_ID).Value) = _
           seriesId Then

            If IsDate(lr.Range.Cells(1, C_SELF_DUE).Value) Then
                If CLng(DateValue( _
                    lr.Range.Cells(1, C_SELF_DUE).Value)) = _
                   CLng(dueDate) Then

                    ExistingSeriesDueId = _
                        CStr(lr.Range.Cells(1, C_TASK_ID).Value)

                    Exit Function
                End If
            End If
        End If
    Next lr
End Function

Private Function NewId(ByVal prefix As String) As String
    mIdSequence = (mIdSequence + 1) Mod 1000

    Randomize Timer + mIdSequence

    NewId = prefix & "-" & _
        Format$(Now, "yyyymmddhhnnss") & "-" & _
        Format$(mIdSequence, "000") & _
        Format$(Int(Rnd() * 1000), "000")
End Function

Private Function DefaultText( _
    ByVal value As Variant, _
    ByVal defaultValue As String) As String

    If Trim$(CStr(value)) = "" Then
        DefaultText = defaultValue
    Else
        DefaultText = CStr(value)
    End If
End Function

Private Function ToBoolean(ByVal value As Variant) As Boolean
    If VarType(value) = vbBoolean Then
        ToBoolean = CBool(value)
    ElseIf IsNumeric(value) Then
        ToBoolean = (CDbl(value) <> 0)
    Else
        ToBoolean = _
            (UCase$(Trim$(CStr(value))) = "TRUE")
    End If
End Function

Private Function TargetSheetExists() As Boolean
    Dim nameValue As Variant

    For Each nameValue In _
        Array(S_TODO, S_ENTRY, S_HISTORY, S_SETTINGS)

        If SheetExists(CStr(nameValue)) Then
            TargetSheetExists = True
            Exit Function
        End If
    Next nameValue
End Function

Private Function SheetExists( _
    ByVal sheetName As String) As Boolean

    Dim ws As Worksheet

    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    SheetExists = Not ws Is Nothing
End Function