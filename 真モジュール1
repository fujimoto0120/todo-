Private Function ResetSheet(ByVal sheetName As String) As Worksheet
    Dim ws As Worksheet
    Dim i As Long

    On Error Resume Next
    Set ws = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add( _
            After:=ThisWorkbook.Worksheets( _
                ThisWorkbook.Worksheets.Count))

        ws.Name = sheetName
    Else
        For i = ws.ListObjects.Count To 1 Step -1
            ws.ListObjects(i).Unlist
        Next i

        For i = ws.Shapes.Count To 1 Step -1
            ws.Shapes(i).Delete
        Next i

        ws.Cells.UnMerge
        ws.Cells.Clear
        ws.Columns.Hidden = False
    End If

    ws.Cells.Font.Name = "Yu Gothic UI"
    ws.Cells.Font.Size = 10

    ws.Activate
    ActiveWindow.DisplayGridlines = False

    Set ResetSheet = ws
End Function

Private Sub FormatTitle( _
    ByVal ws As Worksheet, _
    ByVal titleText As String, _
    ByVal subText As String, _
    ByVal lastColumn As String)

    ws.Range("A1:" & lastColumn & "1").Merge
    ws.Range("A1").Value = titleText

    With ws.Range("A1:" & lastColumn & "1")
        .Interior.Color = RGB(23, 50, 77)
        .Font.Color = vbWhite
        .Font.Bold = True
        .Font.Size = 20
    End With

    ws.Rows(1).RowHeight = 34

    ws.Range("A2:" & lastColumn & "2").Merge
    ws.Range("A2").Value = subText

    With ws.Range("A2:" & lastColumn & "2")
        .Interior.Color = RGB(234, 242, 248)
        .Font.Color = RGB(102, 118, 133)
    End With
End Sub

Private Sub MakeCard( _
    ByVal labelRange As Range, _
    ByVal valueRange As Range, _
    ByVal labelText As String, _
    ByVal formulaText As String, _
    ByVal fillColor As Long)

    labelRange.Merge
    labelRange.Cells(1, 1).Value = labelText
    labelRange.Interior.Color = fillColor
    labelRange.Font.Bold = True
    labelRange.HorizontalAlignment = xlCenter

    valueRange.Merge
    valueRange.Cells(1, 1).Formula = formulaText
    valueRange.Font.Size = 22
    valueRange.Font.Bold = True
    valueRange.HorizontalAlignment = xlCenter
    valueRange.VerticalAlignment = xlCenter
End Sub

Private Sub AddButton( _
    ByVal ws As Worksheet, _
    ByVal address As String, _
    ByVal caption As String, _
    ByVal macroName As String, _
    ByVal fillColor As Long)

    Dim target As Range
    Dim shp As Shape

    Set target = ws.Range(address)
    target.Merge

    Set shp = ws.Shapes.AddShape( _
        msoShapeRoundedRectangle, _
        target.Left, _
        target.Top, _
        target.Width, _
        target.Height)

    With shp
        .Name = "btn_" & macroName
        .Fill.ForeColor.RGB = fillColor
        .Line.ForeColor.RGB = fillColor

        .TextFrame2.TextRange.Text = caption
        .TextFrame2.TextRange.Font.Name = "Yu Gothic UI"
        .TextFrame2.TextRange.Font.Size = 11
        .TextFrame2.TextRange.Font.Bold = msoTrue
        .TextFrame2.TextRange.Font.Fill.ForeColor.RGB = vbWhite
        .TextFrame2.VerticalAnchor = msoAnchorMiddle
        .TextFrame2.TextRange.ParagraphFormat.Alignment = msoAlignCenter

        .OnAction = "'" & ThisWorkbook.Name & "'!" & macroName
        .Placement = xlFreeFloating
    End With
End Sub

Private Sub LabelAndInput( _
    ByVal ws As Worksheet, _
    ByVal labelCell As String, _
    ByVal labelText As String, _
    ByVal inputAddress As String, _
    ByVal mergeInput As Boolean)

    ws.Range(labelCell).Value = labelText
    ws.Range(labelCell).Interior.Color = RGB(234, 242, 248)
    ws.Range(labelCell).Font.Bold = True

    If mergeInput Then
        ws.Range(inputAddress).Merge
    End If

    With ws.Range(inputAddress)
        .Interior.Color = vbWhite
        .Borders.LineStyle = xlContinuous
        .Borders.Color = RGB(175, 192, 206)
    End With
End Sub

Private Sub WriteList( _
    ByVal ws As Worksheet, _
    ByVal headerCell As String, _
    ByVal title As String, _
    ByVal values As Variant)

    Dim startCell As Range
    Dim i As Long

    Set startCell = ws.Range(headerCell)

    startCell.Value = title
    startCell.Interior.Color = RGB(23, 50, 77)
    startCell.Font.Color = vbWhite
    startCell.Font.Bold = True

    For i = 0 To UBound(values)
        startCell.Offset(i + 1, 0).Value = values(i)
        startCell.Offset(i + 1, 0).Interior.Color = _
            RGB(234, 242, 248)
    Next i
End Sub

