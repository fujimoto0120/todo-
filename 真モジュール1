'============================================================
' 初期設定
'============================================================
Public Sub InitialSetup()
    Dim answer As VbMsgBoxResult

    If TargetSheetExists Then
        answer = MsgBox( _
            "ToDo用シートがすでにあります。" & vbCrLf & _
            "続けると同名シートのデータは消去されます。続けますか？", _
            vbExclamation + vbYesNo, "初期設定")

        If answer <> vbYes Then Exit Sub
    End If

    On Error GoTo ErrorHandler

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False

    BuildSettingsSheet ResetSheet(S_SETTINGS)
    BuildTodoSheet ResetSheet(S_TODO)
    BuildEntrySheet ResetSheet(S_ENTRY)
    BuildHistorySheet ResetSheet(S_HISTORY)

    ApplyValidations

    ThisWorkbook.Worksheets(S_TODO).Activate
    SortTasks False

    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "初期設定が完了しました。" & vbCrLf & _
           "「登録」シートからタスクを登録してください。", vbInformation
    Exit Sub

ErrorHandler:
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "初期設定中にエラーが発生しました。" & vbCrLf & _
           Err.Description, vbExclamation
End Sub

Public Sub InitializeOnOpen()
    On Error Resume Next

    ApplyValidations
    EnsureBlankRow TodoTable
    EnsureBlankRow HistoryTable
    SortTasks False

    If ToBoolean(ThisWorkbook.Worksheets(S_SETTINGS).Range("B4").Value) Then
        CleanupHistoryCore False
    End If

    On Error GoTo 0
End Sub

'============================================================
' タスク登録
'============================================================
Public Sub RegisterTask()
    Dim ws As Worksheet
    Dim selfDue As Date
    Dim actualDue As Date
    Dim taskText As String
    Dim repeatType As String
    Dim intervalValue As Long
    Dim dayValue As Long
    Dim endValue As Variant
    Dim seriesId As String

    Set ws = ThisWorkbook.Worksheets(S_ENTRY)

    taskText = Trim$(CStr(ws.Range("C3").Value))

    If taskText = "" Then
        MsgBox "タスクを入力してください。", vbExclamation
        ws.Range("C3").Select
        Exit Sub
    End If

    If Not IsDate(ws.Range("C5").Value) Then
        MsgBox "自分納期を日付で入力してください。", vbExclamation
        Exit Sub
    End If

    selfDue = DateValue(ws.Range("C5").Value)

    If Trim$(CStr(ws.Range("F5").Value)) = "" Then
        actualDue = selfDue
    ElseIf IsDate(ws.Range("F5").Value) Then
        actualDue = DateValue(ws.Range("F5").Value)
    Else
        MsgBox "実納期を日付で入力してください。", vbExclamation
        Exit Sub
    End If

    If actualDue < selfDue Then
        MsgBox "実納期を自分納期より前にはできません。", vbExclamation
        Exit Sub
    End If

    repeatType = Trim$(CStr(ws.Range("C15").Value))
    If repeatType = "" Then repeatType = REC_NONE

    If IsNumeric(ws.Range("F15").Value) Then
        intervalValue = CLng(ws.Range("F15").Value)
    Else
        intervalValue = 1
    End If

    If IsNumeric(ws.Range("C19").Value) Then
        dayValue = CLng(ws.Range("C19").Value)
    Else
        dayValue = 1
    End If

    endValue = ws.Range("C21").Value

    If Not ValidateRepeatInput( _
        repeatType, intervalValue, CStr(ws.Range("F17").Value), _
        dayValue, CStr(ws.Range("F19").Value), endValue, selfDue) Then
        Exit Sub
    End If

    If repeatType <> REC_NONE Then
        seriesId = NewId("R")
    End If

    On Error GoTo ErrorHandler
    Application.EnableEvents = False

    AppendTask _
        taskText, _
        selfDue, _
        actualDue, _
        CStr(ws.Range("C7").Value), _
        DefaultText(ws.Range("F7").Value, "中"), _
        DefaultText(ws.Range("C9").Value, "業務"), _
        DefaultText(ws.Range("F9").Value, "未着手"), _
        repeatType, _
        seriesId, _
        CStr(ws.Range("C11").Value), _
        intervalValue, _
        DefaultText(ws.Range("C17").Value, "元の納期"), _
        DefaultText(ws.Range("F17").Value, "月"), _
        dayValue, _
        DefaultText(ws.Range("F19").Value, "第1"), _
        endValue, _
        CLng(actualDue - selfDue)

    ClearEntryFormCore False
    SortTasks False

    ThisWorkbook.Worksheets(S_TODO).Activate

    Application.EnableEvents = True

    MsgBox "タスクを登録しました。", vbInformation
    Exit Sub

ErrorHandler:
    Application.EnableEvents = True

    MsgBox "登録中にエラーが発生しました。" & vbCrLf & _
           Err.Description, vbExclamation
End Sub

