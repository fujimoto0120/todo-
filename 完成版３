Private Function NormalizeEnabledText(ByVal targetValue As Variant) As String
    Dim normalizedValue As String

    If IsError(targetValue) Or IsEmpty(targetValue) Then
        NormalizeEnabledText = DISABLED_TEXT
        Exit Function
    End If

    If VarType(targetValue) = vbBoolean Then
        If CBool(targetValue) Then
            NormalizeEnabledText = ENABLED_TEXT
        Else
            NormalizeEnabledText = DISABLED_TEXT
        End If
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))
    If normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1" _
        Or normalizedValue = ENABLED_TEXT Then

        NormalizeEnabledText = ENABLED_TEXT
    Else
        NormalizeEnabledText = DISABLED_TEXT
    End If
End Function

Private Function NormalizeRecurringTypeText( _
    ByVal recurringType As String _
) As String
    recurringType = Trim$(recurringType)

    Select Case recurringType
        Case "毎週指定曜日"
            NormalizeRecurringTypeText = RECURRING_TYPE_WEEKLY
        Case "毎月第N曜日"
            NormalizeRecurringTypeText = RECURRING_TYPE_NTH_WEEKDAY
        Case "月末最終営業日", "月末日"
            NormalizeRecurringTypeText = RECURRING_TYPE_MONTH_END
        Case Else
            NormalizeRecurringTypeText = recurringType
    End Select
End Function

Private Sub MigrateRecurringLayoutIfNeeded()
    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim oldValues As Variant
    Dim isOldLayout As Boolean
    Dim recurringType As String

    Set targetSheet = ThisWorkbook.Worksheets(SHEET_RECURRING)
    isOldLayout = (Trim$(CStr(targetSheet.Cells(HEADER_ROW, 2).Value)) = "使用")
    lastRow = GetLastDataRow(targetSheet)

    If isOldLayout And lastRow >= DATA_FIRST_ROW Then
        DeleteCheckboxesByPrefix targetSheet, CHECKBOX_RECURRING_PREFIX

        For rowNumber = DATA_FIRST_ROW To lastRow
            oldValues = targetSheet.Range( _
                targetSheet.Cells(rowNumber, 2), _
                targetSheet.Cells(rowNumber, 12)).Value

            targetSheet.Range( _
                targetSheet.Cells(rowNumber, 2), _
                targetSheet.Cells(rowNumber, 12)).ClearContents

            targetSheet.Cells(rowNumber, COL_RECURRING_ID).Value = oldValues(1, 2)
            targetSheet.Cells(rowNumber, COL_RECURRING_TYPE).Value = _
                NormalizeRecurringTypeText(CStr(oldValues(1, 3)))
            targetSheet.Cells(rowNumber, COL_RECURRING_WEEKDAY).Value = oldValues(1, 4)
            targetSheet.Cells(rowNumber, COL_RECURRING_WEEK_NUMBER).Value = oldValues(1, 5)
            targetSheet.Cells(rowNumber, COL_RECURRING_DAY).Value = oldValues(1, 6)
            targetSheet.Cells(rowNumber, COL_RECURRING_HOLIDAY_ADJUSTMENT).Value = oldValues(1, 7)
            targetSheet.Cells(rowNumber, COL_RECURRING_FIRST_DATE).Value = oldValues(1, 8)
            targetSheet.Cells(rowNumber, COL_RECURRING_NO).Value = oldValues(1, 9)
            targetSheet.Cells(rowNumber, COL_RECURRING_DESCRIPTION).Value = oldValues(1, 10)
            targetSheet.Cells(rowNumber, COL_RECURRING_PRIORITY).Value = oldValues(1, 11)
            targetSheet.Cells(rowNumber, COL_RECURRING_ENABLED).Value = _
                NormalizeEnabledText(oldValues(1, 1))
        Next rowNumber
    End If

    lastRow = GetLastDataRow(targetSheet)
    For rowNumber = DATA_FIRST_ROW To lastRow
        recurringType = NormalizeRecurringTypeText(CStr(GetSafeCellValue( _
            targetSheet.Cells(rowNumber, COL_RECURRING_TYPE))))

        If Len(recurringType) > 0 Then
            targetSheet.Cells(rowNumber, COL_RECURRING_TYPE).Value = recurringType

            If Len(Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
                rowNumber, COL_RECURRING_ENABLED))))) = 0 Then

                targetSheet.Cells(rowNumber, COL_RECURRING_ENABLED).Value = DISABLED_TEXT
            Else
                targetSheet.Cells(rowNumber, COL_RECURRING_ENABLED).Value = _
                    NormalizeEnabledText(targetSheet.Cells( _
                        rowNumber, COL_RECURRING_ENABLED).Value)
            End If

            If recurringType = RECURRING_TYPE_DAILY _
                Or recurringType = RECURRING_TYPE_MONTH_END Then

                targetSheet.Cells( _
                    rowNumber, COL_RECURRING_HOLIDAY_ADJUSTMENT).Value = _
                    HOLIDAY_ADJUST_NONE
            End If
        End If
    Next rowNumber
End Sub

Private Sub MigrateDailySettingsToRecurring()
    Dim dailySheet As Worksheet
    Dim recurringSheet As Worksheet
    Dim todoSheet As Worksheet
    Dim completedSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim destinationRow As Long
    Dim taskId As String
    Dim descriptionText As String

    If GetSystemTextValue(SYSTEM_KEY_DAILY_MIGRATION_DONE) = "はい" Then Exit Sub

    If WorksheetExists(SHEET_DAILY) Then
        Set dailySheet = ThisWorkbook.Worksheets(SHEET_DAILY)
        Set recurringSheet = ThisWorkbook.Worksheets(SHEET_RECURRING)
        lastRow = GetLastDataRow(dailySheet)

        For rowNumber = DATA_FIRST_ROW To lastRow
            taskId = Trim$(CStr(GetSafeCellValue(dailySheet.Cells( _
                rowNumber, COL_DAILY_ID))))
            descriptionText = Trim$(CStr(GetSafeCellValue(dailySheet.Cells( _
                rowNumber, COL_DAILY_DESCRIPTION))))

            If Len(taskId) > 0 Or Len(descriptionText) > 0 Then
                If Len(taskId) = 0 Or FindRecurringSettingRow(taskId) = 0 Then
                    destinationRow = GetNextDataRow( _
                        recurringSheet, COL_RECURRING_DESCRIPTION)

                    If destinationRow > _
                        DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1 Then

                        Err.Raise vbObjectError + 1600, _
                            "MigrateDailySettingsToRecurring", _
                            "毎日業務を統合する空き行がありません。"
                    End If

                    With recurringSheet
                        .Cells(destinationRow, COL_RECURRING_ID).Value = taskId
                        .Cells(destinationRow, COL_RECURRING_TYPE).Value = RECURRING_TYPE_DAILY
                        .Cells(destinationRow, COL_RECURRING_HOLIDAY_ADJUSTMENT).Value = HOLIDAY_ADJUST_NONE
                        .Cells(destinationRow, COL_RECURRING_FIRST_DATE).Value = _
                            AdjustBusinessDate(Date, HOLIDAY_ADJUST_NEXT)
                        .Cells(destinationRow, COL_RECURRING_NO).Value = _
                            GetSafeCellValue(dailySheet.Cells(rowNumber, COL_DAILY_NO))
                        .Cells(destinationRow, COL_RECURRING_DESCRIPTION).Value = descriptionText
                        .Cells(destinationRow, COL_RECURRING_PRIORITY).Value = _
                            GetSafeCellValue(dailySheet.Cells(rowNumber, COL_DAILY_PRIORITY))
                        .Cells(destinationRow, COL_RECURRING_ENABLED).Value = _
                            NormalizeEnabledText(dailySheet.Cells( _
                                rowNumber, COL_DAILY_ENABLED).Value)
                    End With
                End If
            End If
        Next rowNumber

        dailySheet.Visible = xlSheetVeryHidden
    End If

    If WorksheetExists(SHEET_TODO_LIST) Then
        Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
        lastRow = GetLastDataRow(todoSheet)
        For rowNumber = DATA_FIRST_ROW To lastRow
            If Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
                rowNumber, COL_TODO_TASK_TYPE)))) = TASK_TYPE_DAILY Then

                todoSheet.Cells(rowNumber, COL_TODO_TASK_TYPE).Value = TASK_TYPE_RECURRING
            End If
        Next rowNumber
    End If

    If WorksheetExists(SHEET_COMPLETED) Then
        Set completedSheet = ThisWorkbook.Worksheets(SHEET_COMPLETED)
        lastRow = GetLastDataRow(completedSheet)
        For rowNumber = DATA_FIRST_ROW To lastRow
            If Trim$(CStr(GetSafeCellValue(completedSheet.Cells( _
                rowNumber, COL_TODO_TASK_TYPE)))) = TASK_TYPE_DAILY Then

                completedSheet.Cells(rowNumber, COL_TODO_TASK_TYPE).Value = TASK_TYPE_RECURRING
            End If
        Next rowNumber
    End If

    SaveSystemTextValue SYSTEM_KEY_DAILY_MIGRATION_DONE, "はい"
End Sub
