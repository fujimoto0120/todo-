' Backup
Public Sub CreateTemporaryBackup( _
    ByVal processType As String, _
    ByVal sourceSheetNames As Variant _
)

    Dim backupSheet As Worksheet
    Dim sourceSheet As Worksheet
    Dim sheetNameValue As Variant
    Dim lastRow As Long
    Dim lastColumn As Long
    Dim sourceRow As Long
    Dim backupRow As Long
    Dim startedAt As Date

    If Not WorksheetExists(SHEET_BACKUP) Then
        Err.Raise vbObjectError + 1200, _
            "CreateTemporaryBackup", _
            "一時バックアップシートがありません。"
    End If

    ClearTemporaryBackup

    Set backupSheet = ThisWorkbook.Worksheets(SHEET_BACKUP)
    backupRow = DATA_FIRST_ROW
    startedAt = Now

    For Each sheetNameValue In sourceSheetNames
        If Not WorksheetExists(CStr(sheetNameValue)) Then
            Err.Raise vbObjectError + 1201, _
                "CreateTemporaryBackup", _
                CStr(sheetNameValue) & "シートがありません。"
        End If

        Set sourceSheet = _
            ThisWorkbook.Worksheets(CStr(sheetNameValue))

        lastColumn = GetBackupLastColumn(sourceSheet.Name)
        lastRow = GetLastDataRow(sourceSheet)

        If lastRow < DATA_FIRST_ROW Then
            WriteBackupMetadata _
                backupSheet, _
                backupRow, _
                processType, _
                sourceSheet.Name, _
                0, _
                startedAt

            backupRow = backupRow + 1
        Else
            For sourceRow = DATA_FIRST_ROW To lastRow
                WriteBackupMetadata _
                    backupSheet, _
                    backupRow, _
                    processType, _
                    sourceSheet.Name, _
                    sourceRow, _
                    startedAt

                backupSheet.Range( _
                    backupSheet.Cells( _
                        backupRow, COL_BACKUP_DATA_FIRST), _
                    backupSheet.Cells( _
                        backupRow, _
                        COL_BACKUP_DATA_FIRST + lastColumn - 1)).Value = _
                    sourceSheet.Range( _
                        sourceSheet.Cells(sourceRow, 1), _
                        sourceSheet.Cells( _
                            sourceRow, lastColumn)).Value

                backupRow = backupRow + 1
            Next sourceRow
        End If
    Next sheetNameValue

    backupSheet.Visible = xlSheetVeryHidden
End Sub

Public Sub RestoreTemporaryBackup()
    Dim backupSheet As Worksheet
    Dim sourceSheet As Worksheet
    Dim sheetNames As Object
    Dim lastBackupRow As Long
    Dim backupRow As Long
    Dim sourceRow As Long
    Dim lastColumn As Long
    Dim clearLastRow As Long
    Dim sheetName As String
    Dim sheetNameValue As Variant

    If Not WorksheetExists(SHEET_BACKUP) Then
        Err.Raise vbObjectError + 1202, _
            "RestoreTemporaryBackup", _
            "一時バックアップシートがありません。"
    End If

    Set backupSheet = ThisWorkbook.Worksheets(SHEET_BACKUP)
    lastBackupRow = GetLastDataRow( _
        backupSheet, COL_BACKUP_SOURCE_SHEET)

    If lastBackupRow < DATA_FIRST_ROW Then Exit Sub

    Set sheetNames = CreateObject("Scripting.Dictionary")
    sheetNames.CompareMode = vbTextCompare

    For backupRow = DATA_FIRST_ROW To lastBackupRow
        sheetName = Trim$(CStr(GetSafeCellValue( _
            backupSheet.Cells( _
                backupRow, COL_BACKUP_SOURCE_SHEET))))

        If Len(sheetName) > 0 Then
            If Not sheetNames.Exists(sheetName) Then
                sheetNames.Add sheetName, True
            End If
        End If
    Next backupRow

    For Each sheetNameValue In sheetNames.Keys
        If Not WorksheetExists(CStr(sheetNameValue)) Then
            Err.Raise vbObjectError + 1203, _
                "RestoreTemporaryBackup", _
                CStr(sheetNameValue) & "シートがありません。"
        End If

        Set sourceSheet = _
            ThisWorkbook.Worksheets(CStr(sheetNameValue))

        lastColumn = GetBackupLastColumn(sourceSheet.Name)
        clearLastRow = GetLastDataRow(sourceSheet)

        If clearLastRow < GetLayoutLastRow(sourceSheet.Name) Then
            clearLastRow = GetLayoutLastRow(sourceSheet.Name)
        End If

        If clearLastRow >= DATA_FIRST_ROW Then
            sourceSheet.Range( _
                sourceSheet.Cells(DATA_FIRST_ROW, 1), _
                sourceSheet.Cells( _
                    clearLastRow, lastColumn)).ClearContents
        End If
    Next sheetNameValue

    For backupRow = DATA_FIRST_ROW To lastBackupRow
        sheetName = Trim$(CStr(GetSafeCellValue( _
            backupSheet.Cells( _
                backupRow, COL_BACKUP_SOURCE_SHEET))))

        sourceRow = GetSafeLongValue(backupSheet.Cells( _
            backupRow, COL_BACKUP_SOURCE_ROW).Value)

        If Len(sheetName) > 0 And sourceRow >= DATA_FIRST_ROW Then
            Set sourceSheet = _
                ThisWorkbook.Worksheets(sheetName)

            lastColumn = GetBackupLastColumn(sheetName)

            sourceSheet.Range( _
                sourceSheet.Cells(sourceRow, 1), _
                sourceSheet.Cells(sourceRow, lastColumn)).Value = _
                backupSheet.Range( _
                    backupSheet.Cells( _
                        backupRow, COL_BACKUP_DATA_FIRST), _
                    backupSheet.Cells( _
                        backupRow, _
                        COL_BACKUP_DATA_FIRST + lastColumn - 1)).Value
        End If
    Next backupRow

    ClearTemporaryBackup
End Sub

Public Sub ClearTemporaryBackup()
    Dim backupSheet As Worksheet
