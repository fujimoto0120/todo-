Private Sub CheckHolidayIntegrity( _
    ByRef errorList As String, _
    ByRef errorCount As Long _
)

    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim targetValue As Variant

    Set targetSheet = ThisWorkbook.Worksheets(SHEET_HOLIDAY)
    lastRow = GetLastDataRow( _
        targetSheet, COL_HOLIDAY_DATE)

    For rowNumber = DATA_FIRST_ROW To lastRow
        targetValue = GetSafeCellValue(targetSheet.Cells( _
            rowNumber, COL_HOLIDAY_DATE))

        If Len(Trim$(CStr(targetValue))) > 0 Then
            If Not IsValidExcelDate(targetValue) Then
                AddIntegrityError _
                    errorList, _
                    errorCount, _
                    SHEET_HOLIDAY & " " & _
                        CStr(rowNumber) & _
                        "行：休業日が日付ではありません。"
            End If
        End If
    Next rowNumber
End Sub

Private Sub AddIntegrityError( _
    ByRef errorList As String, _
    ByRef errorCount As Long, _
    ByVal messageText As String _
)

    errorCount = errorCount + 1

    If errorCount <= 50 Then
        errorList = errorList & messageText & vbCrLf
    End If
End Sub

Private Function GeneralValueIsTrue( _
    ByVal targetValue As Variant _
) As Boolean

    Dim normalizedValue As String

    If IsError(targetValue) Then Exit Function
    If IsEmpty(targetValue) Then Exit Function

    If VarType(targetValue) = vbBoolean Then
        GeneralValueIsTrue = CBool(targetValue)
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))

    GeneralValueIsTrue = _
        (normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1" _
        Or normalizedValue = ENABLED_TEXT)
End Function
