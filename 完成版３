Public Function ValidateRecurringSettingRow( _
    ByVal recurringSheet As Worksheet, _
    ByVal rowNumber As Long, _
    ByRef errorMessage As String _
) As Boolean

    Dim recurringType As String
    Dim weekdayText As String
    Dim adjustmentType As String
    Dim descriptionText As String
    Dim priorityText As String
    Dim firstDate As Date
    Dim ignoredNumber As Long

    errorMessage = vbNullString

    If rowNumber < DATA_FIRST_ROW _
        Or rowNumber > _
            DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1 Then

        errorMessage = "定期業務のデータ行ではありません。"
        Exit Function
    End If

    recurringType = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            rowNumber, COL_RECURRING_TYPE))))

    Select Case recurringType
        Case RECURRING_TYPE_DAILY, _
            RECURRING_TYPE_WEEKLY, _
            RECURRING_TYPE_MONTHLY_DAY, _
            RECURRING_TYPE_NTH_WEEKDAY, _
            RECURRING_TYPE_LAST_WEEKDAY, _
            RECURRING_TYPE_MONTH_END, _
            RECURRING_TYPE_LAST_BUSINESS_DAY

        Case Else
            errorMessage = "繰り返し種別を選択してください。"
            Exit Function
    End Select

    If Not IsValidExcelDate(recurringSheet.Cells( _
        rowNumber, COL_RECURRING_FIRST_DATE).Value) Then

        errorMessage = "初回予定日を日付で入力してください。"
        Exit Function
    End If

    firstDate = DateOnlyValue(recurringSheet.Cells( _
        rowNumber, COL_RECURRING_FIRST_DATE).Value)

    If recurringType = RECURRING_TYPE_DAILY Then
        If IsHoliday(firstDate) Then
            errorMessage = "「毎日」の初回予定日は営業日を選択してください。"
            Exit Function
        End If
    End If

    weekdayText = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            rowNumber, COL_RECURRING_WEEKDAY))))

    If recurringType = RECURRING_TYPE_WEEKLY _
        Or recurringType = RECURRING_TYPE_NTH_WEEKDAY _
        Or recurringType = RECURRING_TYPE_LAST_WEEKDAY Then

        On Error GoTo InvalidWeekday
        ignoredNumber = GetWeekdayNumber(weekdayText)
        On Error GoTo 0
    End If

    If recurringType = RECURRING_TYPE_WEEKLY Then
        If Weekday(firstDate, vbSunday) <> _
            GetWeekdayNumber(weekdayText) Then

            errorMessage = _
                "初回予定日の曜日と指定曜日が一致しません。"

            Exit Function
        End If
    End If

    If recurringType = RECURRING_TYPE_NTH_WEEKDAY Then
        On Error GoTo InvalidWeekNumber

        ignoredNumber = GetTextInteger( _
            recurringSheet.Cells( _
                rowNumber, _
                COL_RECURRING_WEEK_NUMBER).Value, _
            1, _
            5)

        On Error GoTo 0
    End If

    If recurringType = RECURRING_TYPE_MONTHLY_DAY Then
        On Error GoTo InvalidDayNumber

        ignoredNumber = GetTextInteger( _
            recurringSheet.Cells( _
                rowNumber, COL_RECURRING_DAY).Value, _
            1, _
            31)

        On Error GoTo 0
    End If

    adjustmentType = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            rowNumber, _
            COL_RECURRING_HOLIDAY_ADJUSTMENT))))

    If recurringType = RECURRING_TYPE_DAILY _
        Or recurringType = RECURRING_TYPE_MONTH_END Then

        recurringSheet.Cells( _
            rowNumber, COL_RECURRING_HOLIDAY_ADJUSTMENT).Value = _
            HOLIDAY_ADJUST_NONE
        adjustmentType = HOLIDAY_ADJUST_NONE
    End If

    If adjustmentType <> HOLIDAY_ADJUST_PREVIOUS _
        And adjustmentType <> HOLIDAY_ADJUST_NEXT _
        And adjustmentType <> HOLIDAY_ADJUST_NONE Then

        errorMessage = "休日調整を選択してください。"
        Exit Function
    End If

    descriptionText = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            rowNumber, COL_RECURRING_DESCRIPTION))))

    If Len(descriptionText) = 0 Then
        errorMessage = "行うことを入力してください。"
        Exit Function
    End If

    priorityText = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            rowNumber, COL_RECURRING_PRIORITY))))

    If Not IsAllowedPriority(priorityText) Then
        errorMessage = _
            "優先度は「高」「中」「低」または空欄にしてください。"

        Exit Function
    End If

    ValidateRecurringSettingRow = True
    Exit Function

InvalidWeekday:
    errorMessage = "曜日を選択してください。"
    Exit Function

InvalidWeekNumber:
    errorMessage = "週番号は1から5で入力してください。"
    Exit Function

InvalidDayNumber:
    errorMessage = "日は1から31で入力してください。"
End Function

Private Sub EnsureRecurringTaskId( _
    ByVal recurringSheet As Worksheet, _
    ByVal settingRow As Long _
)

    Dim taskId As String

    taskId = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID))))

    If Len(taskId) = 0 Then
        taskId = GenerateNextId( _
            RECURRING_ID_PREFIX, _
            SHEET_RECURRING, _
            COL_RECURRING_ID, _
            SYSTEM_KEY_NEXT_RECURRING_ID)

        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID).NumberFormat = _
            NO_DISPLAY_FORMAT

        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID).Value = taskId
    End If
End Sub

Private Function RecurringRowIsEnabled( _
    ByVal recurringSheet As Worksheet, _
    ByVal rowNumber As Long _
) As Boolean

    Dim targetValue As Variant
    Dim normalizedValue As String

    targetValue = GetSafeCellValue(recurringSheet.Cells( _
        rowNumber, COL_RECURRING_ENABLED))

    If VarType(targetValue) = vbBoolean Then
        RecurringRowIsEnabled = CBool(targetValue)
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))

    RecurringRowIsEnabled = _
        (normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1" _
        Or normalizedValue = ENABLED_TEXT)
End Function

Private Function GetRecurringSettingDataCount() As Long
    Dim recurringSheet As Worksheet
    Dim rowNumber As Long
    Dim lastRow As Long

    Set recurringSheet = _
        ThisWorkbook.Worksheets(SHEET_RECURRING)

    lastRow = GetLastDataRow(recurringSheet)

    For rowNumber = DATA_FIRST_ROW To lastRow
        If Application.CountA(recurringSheet.Range( _
            recurringSheet.Cells( _
                rowNumber, COL_RECURRING_FIRST), _
            recurringSheet.Cells( _
                rowNumber, COL_RECURRING_LAST))) > 0 Then

            GetRecurringSettingDataCount = _
                GetRecurringSettingDataCount + 1
        End If
    Next rowNumber
End Function

Private Sub SetRecurringCheckboxOff( _
    ByVal recurringSheet As Worksheet, _
    ByVal checkboxName As String, _
    ByVal targetRow As Long _
)

    recurringSheet.Cells( _
        targetRow, COL_RECURRING_ENABLED).Value = False

    recurringSheet.Shapes( _
        checkboxName).ControlFormat.Value = xlOff
End Sub

Private Sub ClearRecurringRowError( _
    ByVal recurringSheet As Worksheet, _
    ByVal targetRow As Long _
)

    With recurringSheet.Range( _
        recurringSheet.Cells( _
            targetRow, COL_RECURRING_TYPE), _
        recurringSheet.Cells( _
            targetRow, COL_RECURRING_ENABLED))

        .Interior.Color = COLOR_WHITE
        .Font.Color = COLOR_TEXT_NAVY
    End With
End Sub

Private Sub MarkRecurringRowError( _
    ByVal recurringSheet As Worksheet, _
    ByVal targetRow As Long _
)

    With recurringSheet.Range( _
        recurringSheet.Cells( _
            targetRow, COL_RECURRING_TYPE), _
        recurringSheet.Cells( _
            targetRow, COL_RECURRING_ENABLED))

        .Interior.Color = COLOR_ERROR_BACKGROUND
        .Font.Color = COLOR_ERROR_TEXT
    End With
End Sub

' Completion
Public Sub CompleteTodoFromCheckbox( _
    Optional ByVal targetRow As Long = 0 _
)

    Dim savedState As TExcelState
    Dim todoSheet As Worksheet
    Dim completedSheet As Worksheet
    Dim destinationRow As Long
    Dim rowError As String
    Dim taskType As String
    Dim taskId As String
    Dim originalDate As Date
    Dim sourceSettingRow As Long
    Dim sourceRowValue As Variant
    Dim backupCreated As Boolean
    Dim nextTaskCreated As Boolean
    Dim nextTaskError As String
    Dim errorText As String

    On Error GoTo ErrorHandler

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    If Not WorksheetExists(SHEET_TODO_LIST) _
        Or Not WorksheetExists(SHEET_COMPLETED) Then

        MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    Set completedSheet = _
        ThisWorkbook.Worksheets(SHEET_COMPLETED)

    If targetRow = 0 Then
        targetRow = GetCallerCheckboxRow(SHEET_TODO_LIST)
    End If

    If targetRow < DATA_FIRST_ROW _
        Or targetRow > GetLastDataRow(todoSheet) Then

        MsgBox "完了するToDoを確認できません。", _
            vbExclamation, APP_TITLE

        GoTo ExitHandler
    End If

    If Not ValidateTodoRow( _
        todoSheet, targetRow, rowError) Then

        MsgBox CStr(targetRow) & "行：" & rowError, _
            vbExclamation, APP_TITLE

        GoTo ExitHandler
    End If

    taskType = Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
        targetRow, COL_TODO_TASK_TYPE))))

    taskId = Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
        targetRow, COL_TODO_TASK_ID))))

    originalDate = DateOnlyValue(todoSheet.Cells( _
        targetRow, COL_TODO_ORIGINAL_DATE).Value)

    sourceRowValue = GetSafeCellValue(todoSheet.Cells( _
        targetRow, COL_TODO_SOURCE_ROW))

    If IsNumeric(sourceRowValue) Then
        sourceSettingRow = CLng(sourceRowValue)
    End If

    CreateTemporaryBackup _
        "ToDo完了", _
        Array(SHEET_TODO_LIST, SHEET_COMPLETED)

    backupCreated = True
    destinationRow = GetNextDataRow(completedSheet)

    completedSheet.Range( _
        completedSheet.Cells( _
            destinationRow, COL_TODO_FIRST), _
        completedSheet.Cells( _
            destinationRow, COL_TODO_LAST)).Value = _
        todoSheet.Range( _
            todoSheet.Cells(targetRow, COL_TODO_FIRST), _
            todoSheet.Cells(targetRow, COL_TODO_LAST)).Value

    completedSheet.Cells( _
        destinationRow, COL_TODO_COMPLETED_AT).Value = Now

    completedSheet.Cells( _
        destinationRow, COL_TODO_CHECK).ClearContents

    If Trim$(CStr(GetSafeCellValue(completedSheet.Cells( _
        destinationRow, COL_TODO_TASK_TYPE)))) <> taskType Then

        Err.Raise vbObjectError + 1500, _
            "CompleteTodoFromCheckbox", _
            "完了済みシートへの書き込みを確認できません。"
    End If

    todoSheet.Range( _
        todoSheet.Cells(targetRow, COL_TODO_FIRST), _
        todoSheet.Cells(targetRow, COL_TODO_LAST)).Delete _
        Shift:=xlUp

    If taskType = TASK_TYPE_RECURRING Then
        On Error Resume Next

        nextTaskCreated = CreateNextRecurringTask( _
            taskId, _
            originalDate, _
            sourceSettingRow)

        If Err.Number <> 0 Then
            nextTaskError = Err.Description
            Err.Clear
        ElseIf Not nextTaskCreated Then
            nextTaskError = _
                "次回タスクの作成結果を確認できませんでした。"
        End If

        On Error GoTo ErrorHandler
    End If

    SortTodoListCore
    RebuildTodoCheckboxes
    RefreshTodoDisplayCore
    RebuildCompletedCheckboxes

    ClearTemporaryBackup
    backupCreated = False

    If Len(nextTaskError) > 0 Then
        MsgBox "現在のToDoは完了済みへ移動しました。" & _
            vbCrLf & _
            "次回の定期業務は作成できませんでした。" & _
            vbCrLf & _
            "業務ID：" & taskId & _
            vbCrLf & _
            "内容：" & nextTaskError, _
            vbExclamation, APP_TITLE
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If backupCreated Then
        RestoreTemporaryBackup
        RebuildTodoCheckboxes
        RebuildCompletedCheckboxes
    End If

    On Error GoTo 0

    ShowProcessError _
        "ToDoの完了", _
        SHEET_TODO_LIST, _
        targetRow, _
        taskId, _
        errorText

    Resume ExitHandler
End Sub

Public Sub RestoreSelectedCompletedTodos()
    Dim savedState As TExcelState
    Dim todoSheet As Worksheet
    Dim completedSheet As Worksheet
    Dim selectedRows As Object
    Dim shapeIndex As Long
    Dim targetShape As Shape
    Dim targetRow As Long
    Dim selectedCount As Long
    Dim destinationRow As Long
    Dim lastCompletedRow As Long
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler

    If Not WorksheetExists(SHEET_TODO_LIST) _
        Or Not WorksheetExists(SHEET_COMPLETED) Then

        MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        Exit Sub
    End If

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    Set completedSheet = _
        ThisWorkbook.Worksheets(SHEET_COMPLETED)

    Set selectedRows = CreateObject("Scripting.Dictionary")

    For shapeIndex = 1 To completedSheet.Shapes.Count
        Set targetShape = completedSheet.Shapes(shapeIndex)

        If Left$( _
            targetShape.Name, _
            Len(CHECKBOX_COMPLETED_PREFIX)) = _
            CHECKBOX_COMPLETED_PREFIX Then

            If targetShape.ControlFormat.Value = xlOn Then
                targetRow = targetShape.TopLeftCell.Row

                If targetRow >= DATA_FIRST_ROW Then
                    If Not selectedRows.Exists( _
                        CStr(targetRow)) Then

                        selectedRows.Add CStr(targetRow), True
                    End If
                End If
            End If
        End If
    Next shapeIndex

    selectedCount = selectedRows.Count

    If selectedCount = 0 Then
        MsgBox "未完了へ戻す行をチェックしてください。", _
            vbInformation, APP_TITLE

        Exit Sub
    End If

    If Not CanAddTodoRows(selectedCount, True) Then Exit Sub

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    CreateTemporaryBackup _
        "未完了へ戻す", _
        Array(SHEET_TODO_LIST, SHEET_COMPLETED)

    backupCreated = True
    lastCompletedRow = GetLastDataRow(completedSheet)

    For targetRow = DATA_FIRST_ROW To lastCompletedRow
        If selectedRows.Exists(CStr(targetRow)) Then
            destinationRow = GetNextDataRow(todoSheet)

            todoSheet.Range( _
                todoSheet.Cells( _
                    destinationRow, COL_TODO_FIRST), _
                todoSheet.Cells( _
                    destinationRow, COL_TODO_LAST)).Value = _
                completedSheet.Range( _
                    completedSheet.Cells( _
                        targetRow, COL_TODO_FIRST), _
                    completedSheet.Cells( _
                        targetRow, COL_TODO_LAST)).Value

            todoSheet.Cells( _
                destinationRow, COL_TODO_COMPLETED_AT).ClearContents

            todoSheet.Cells( _
                destinationRow, COL_TODO_CHECK).ClearContents

            todoSheet.Cells( _
                destinationRow, _
                COL_TODO_PROCESS_STATUS).Value = _
                PROCESS_STATUS_CONFIRMED

            todoSheet.Cells( _
                destinationRow, COL_TODO_PREVIOUS_KEY).Value = _
                BuildTodoDataKey(todoSheet, destinationRow)
        End If
    Next targetRow

    For targetRow = lastCompletedRow To DATA_FIRST_ROW Step -1
        If selectedRows.Exists(CStr(targetRow)) Then
            completedSheet.Range( _
                completedSheet.Cells( _
                    targetRow, COL_TODO_FIRST), _
                completedSheet.Cells( _
                    targetRow, COL_TODO_LAST)).Delete _
                Shift:=xlUp
        End If
    Next targetRow

    SortTodoListCore
    RebuildTodoCheckboxes
    RefreshTodoDisplayCore
    RebuildCompletedCheckboxes

    ClearTemporaryBackup
    backupCreated = False

    MsgBox CStr(selectedCount) & _
        "件を未完了へ戻しました。", _
        vbInformation, APP_TITLE

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If backupCreated Then
        RestoreTemporaryBackup
        RebuildTodoCheckboxes
        RebuildCompletedCheckboxes
    End If

    On Error GoTo 0

    ShowProcessError _
        "未完了への復帰", _
        SHEET_COMPLETED, _
        targetRow, _
        vbNullString, _
        errorText

    Resume ExitHandler
End Sub

Public Sub DeleteExpiredCompletedTodos()
    Dim savedState As TExcelState
    Dim completedSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim retentionDays As Long
    Dim completedValue As Variant
    Dim deleteRows As Object
    Dim deleteCount As Long
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler

    If Not WorksheetExists(SHEET_COMPLETED) Then
        MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        Exit Sub
    End If

    Set completedSheet = _
        ThisWorkbook.Worksheets(SHEET_COMPLETED)

    retentionDays = GetSettingLong( _
        SETTING_COMPLETED_RETENTION_DAYS, _
        DEFAULT_COMPLETED_RETENTION_DAYS, _
        0)

    lastRow = GetLastDataRow(completedSheet)
    Set deleteRows = CreateObject("Scripting.Dictionary")

    For rowNumber = DATA_FIRST_ROW To lastRow
        completedValue = GetSafeCellValue(completedSheet.Cells( _
            rowNumber, COL_TODO_COMPLETED_AT))

        If IsDate(completedValue) Then
            If DateDiff( _
                "d", _
                DateValue(CDate(completedValue)), _
                Date) >= retentionDays Then

                deleteRows.Add CStr(rowNumber), True
            End If
        End If
    Next rowNumber

    deleteCount = deleteRows.Count

    If deleteCount = 0 Then
        MsgBox "削除対象の完了データはありません。", _
            vbInformation, APP_TITLE

        Exit Sub
    End If

    If MsgBox( _
        CStr(deleteCount) & _
            "件の完了データを削除しますか？", _
        vbQuestion + vbYesNo + vbDefaultButton2, _
        APP_TITLE) <> vbYes Then

        Exit Sub
    End If

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    CreateTemporaryBackup _
        "完了済み期限削除", _
        Array(SHEET_COMPLETED)

    backupCreated = True

    For rowNumber = lastRow To DATA_FIRST_ROW Step -1
        If deleteRows.Exists(CStr(rowNumber)) Then
            completedSheet.Range( _
                completedSheet.Cells( _
                    rowNumber, COL_TODO_FIRST), _
                completedSheet.Cells( _
                    rowNumber, COL_TODO_LAST)).Delete _
                Shift:=xlUp
        End If
    Next rowNumber

    RebuildCompletedCheckboxes
    ClearTemporaryBackup
    backupCreated = False

    MsgBox CStr(deleteCount) & _
        "件を削除しました。", _
        vbInformation, APP_TITLE

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If backupCreated Then
        RestoreTemporaryBackup
        RebuildCompletedCheckboxes
    End If

    On Error GoTo 0

    ShowProcessError _
        "完了済みデータの削除", _
        SHEET_COMPLETED, _
        rowNumber, _
        vbNullString, _
        errorText

    Resume ExitHandler
End Sub

' Startup and events
Public Sub RunWorkbookStartup()
    Dim savedState As TExcelState
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler
    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
        .DisplayAlerts = False
    End With

    If Not RequiredSheetsExist() Then
        CreateRequiredSheets
        SetupAllSheets
    ElseIf GetSystemTextValue(SYSTEM_KEY_LAYOUT_VERSION) <> _
        CURRENT_LAYOUT_VERSION Then

        SetupAllSheets
    End If

    If HasTemporaryBackup() Then RestoreTemporaryBackup

    RefreshDateChoiceList
    RegisterTodayDailyTasksAtStartup

    CreateTemporaryBackup _
        "起動時並べ替え", _
        Array(SHEET_TODO_LIST)
    backupCreated = True

    SortTodoListCore
    RefreshTodoDisplayCore
    RebuildAllCheckboxes

    ClearTemporaryBackup
    backupCreated = False

    ThisWorkbook.Worksheets(SHEET_SYSTEM).Visible = xlSheetVeryHidden
    ThisWorkbook.Worksheets(SHEET_BACKUP).Visible = xlSheetVeryHidden
    If WorksheetExists(SHEET_DAILY) Then
        ThisWorkbook.Worksheets(SHEET_DAILY).Visible = xlSheetVeryHidden
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description
    On Error Resume Next
    If backupCreated Then
        RestoreTemporaryBackup
        RebuildAllCheckboxes
    End If
    On Error GoTo 0

    ShowProcessError _
        "ブック起動処理", _
        vbNullString, _
        0, _
        vbNullString, _
        errorText
    Resume ExitHandler
End Sub
Public Sub HandleTodoListSheetChange( _
    ByVal changedRange As Range _
)

    Dim todoSheet As Worksheet
    Dim watchedRange As Range
    Dim affectedRange As Range
    Dim targetCell As Range
    Dim changedRows As Object
    Dim rowKey As Variant
    Dim rowNumber As Long

    On Error GoTo ExitHandler

    If changedRange Is Nothing Then Exit Sub
    If changedRange.CountLarge > 1000 Then Exit Sub

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)

    Set watchedRange = todoSheet.Range( _
        todoSheet.Cells(DATA_FIRST_ROW, COL_TODO_DUE), _
        todoSheet.Cells( _
            DATA_FIRST_ROW + ABSOLUTE_TODO_MAX - 1, _
            COL_TODO_DESCRIPTION))

    Set affectedRange = Intersect(changedRange, watchedRange)
    If affectedRange Is Nothing Then Exit Sub

    Application.EnableEvents = False
    Set changedRows = CreateObject("Scripting.Dictionary")

    For Each targetCell In affectedRange.Cells
        If Not changedRows.Exists(CStr(targetCell.Row)) Then
            changedRows.Add CStr(targetCell.Row), True
        End If
    Next targetCell

    For Each rowKey In changedRows.Keys
        rowNumber = CLng(rowKey)

        todoSheet.Cells( _
            rowNumber, COL_TODO_NO).NumberFormat = _
            NO_DISPLAY_FORMAT

        If Application.CountA(todoSheet.Range( _
            todoSheet.Cells( _
                rowNumber, COL_TODO_FIRST), _
            todoSheet.Cells( _
                rowNumber, COL_TODO_LAST))) > 0 Then

            todoSheet.Cells( _
                rowNumber, COL_TODO_PROCESS_STATUS).Value = _
                PROCESS_STATUS_UNCONFIRMED
        End If
    Next rowKey

ExitHandler:
    Application.EnableEvents = True
End Sub

Public Sub CheckAllDataIntegrity()
    Dim savedState As TExcelState
    Dim errorList As String
    Dim errorCount As Long

    On Error GoTo ErrorHandler

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    If Not RequiredSheetsExist() Then
        MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    CheckTodoSheetIntegrity _
        SHEET_TODO_LIST, errorList, errorCount

    CheckTodoSheetIntegrity _
        SHEET_COMPLETED, errorList, errorCount

    CheckRecurringIntegrity errorList, errorCount
    CheckHolidayIntegrity errorList, errorCount

    If errorCount = 0 Then
        MsgBox "データの問題は見つかりませんでした。", _
            vbInformation, APP_TITLE
    Else
        If errorCount > 50 Then
            errorList = errorList & _
                "ほか " & CStr(errorCount - 50) & _
                "件の問題があります。" & vbCrLf
        End If

        MsgBox CStr(errorCount) & _
            "件の問題が見つかりました。" & _
            vbCrLf & vbCrLf & errorList, _
            vbExclamation, APP_TITLE
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    ShowProcessError _
        "全データの整合性確認", _
        vbNullString, _
        0, _
        vbNullString, _
        Err.Description

    Resume ExitHandler
End Sub

Private Function RequiredSheetsExist() As Boolean
    Dim requiredNames As Variant
    Dim nameValue As Variant

    requiredNames = Array( _
        SHEET_TODO_ADD, _
        SHEET_TODO_LIST, _
        SHEET_COMPLETED, _
        SHEET_RECURRING, _
        SHEET_HOLIDAY, _
        SHEET_SETTINGS, _
        SHEET_SYSTEM, _
        SHEET_BACKUP)

    For Each nameValue In requiredNames
        If Not WorksheetExists(CStr(nameValue)) Then Exit Function
    Next nameValue

    RequiredSheetsExist = True
End Function
Private Sub CheckTodoSheetIntegrity( _
    ByVal sheetName As String, _
    ByRef errorList As String, _
    ByRef errorCount As Long _
)

    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim rowError As String

    Set targetSheet = ThisWorkbook.Worksheets(sheetName)
    lastRow = GetLastDataRow(targetSheet)

    For rowNumber = DATA_FIRST_ROW To lastRow
        If Application.CountA(targetSheet.Range( _
            targetSheet.Cells( _
                rowNumber, COL_TODO_FIRST), _
            targetSheet.Cells( _
                rowNumber, COL_TODO_LAST))) > 0 Then

            rowError = vbNullString

            If Not ValidateTodoRow( _
                targetSheet, _
                rowNumber, _
                rowError, _
                False) Then

                AddIntegrityError _
                    errorList, _
                    errorCount, _
                    sheetName & " " & _
                        CStr(rowNumber) & "行：" & rowError
            End If
        End If
    Next rowNumber
End Sub

Private Sub CheckDailyIntegrity( _
