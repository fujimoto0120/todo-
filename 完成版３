Private Sub RebuildSettingCheckboxes( _
    ByVal targetSheet As Worksheet, _
    ByVal checkboxPrefix As String, _
    ByVal checkboxColumn As Long, _
    ByVal lastRow As Long, _
    ByVal macroName As String _
)

    Dim rowNumber As Long
    Dim isEnabled As Boolean

    DeleteCheckboxesByPrefix targetSheet, checkboxPrefix

    For rowNumber = DATA_FIRST_ROW To lastRow
        isEnabled = CheckboxValueIsTrue( _
            targetSheet.Cells(rowNumber, checkboxColumn).Value)

        targetSheet.Cells( _
            rowNumber, checkboxColumn).Value = isEnabled

        targetSheet.Cells( _
            rowNumber, checkboxColumn).NumberFormat = ";;;"

        AddFormCheckbox _
            targetSheet, _
            targetSheet.Cells(rowNumber, checkboxColumn), _
            checkboxPrefix & CStr(rowNumber), _
            macroName, _
            isEnabled
    Next rowNumber
End Sub

Private Sub AddFormCheckbox( _
    ByVal targetSheet As Worksheet, _
    ByVal targetCell As Range, _
    ByVal checkboxName As String, _
    ByVal macroName As String, _
    ByVal isChecked As Boolean _
)

    Dim newCheckbox As CheckBox
    Dim checkboxSize As Double

    checkboxSize = 14

    Set newCheckbox = targetSheet.CheckBoxes.Add( _
        targetCell.Left + _
            (targetCell.Width - checkboxSize) / 2, _
        targetCell.Top + _
            (targetCell.Height - checkboxSize) / 2, _
        checkboxSize, _
        checkboxSize)

    With newCheckbox
        .Name = checkboxName
        .Caption = vbNullString
        .OnAction = macroName
        .Placement = xlMoveAndSize
        .PrintObject = False
        .LinkedCell = vbNullString

        If isChecked Then
            .Value = xlOn
        Else
            .Value = xlOff
        End If
    End With
End Sub

Private Sub DeleteCheckboxesByPrefix( _
    ByVal targetSheet As Worksheet, _
    ByVal checkboxPrefix As String _
)

    Dim shapeIndex As Long
    Dim shapeName As String

    For shapeIndex = targetSheet.Shapes.Count To 1 Step -1
        shapeName = targetSheet.Shapes(shapeIndex).Name

        If Left$(shapeName, Len(checkboxPrefix)) = checkboxPrefix Then
            targetSheet.Shapes(shapeIndex).Delete
        End If
    Next shapeIndex
End Sub

Private Function CheckboxValueIsTrue( _
    ByVal targetValue As Variant _
) As Boolean

    Dim normalizedValue As String

    If IsError(targetValue) Then Exit Function
    If IsEmpty(targetValue) Then Exit Function

    If VarType(targetValue) = vbBoolean Then
        CheckboxValueIsTrue = CBool(targetValue)
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))

    CheckboxValueIsTrue = _
        (normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1")
End Function

' Calendar
Public Function IsHoliday( _
    ByVal targetDate As Date _
) As Boolean

    Dim weekdayValue As Long

    targetDate = DateValue(targetDate)
    weekdayValue = Weekday(targetDate, vbSunday)

    If weekdayValue = vbSaturday Then
        If GetSettingBoolean( _
            SETTING_SATURDAY_IS_HOLIDAY, _
            DEFAULT_SATURDAY_IS_HOLIDAY, _
            False) Then

            IsHoliday = True
            Exit Function
        End If
    End If

    If weekdayValue = vbSunday Then
        If GetSettingBoolean( _
            SETTING_SUNDAY_IS_HOLIDAY, _
            DEFAULT_SUNDAY_IS_HOLIDAY, _
            False) Then

            IsHoliday = True
            Exit Function
        End If
    End If

    IsHoliday = IsCompanyHoliday(targetDate)
End Function

Public Function IsCompanyHoliday( _
    ByVal targetDate As Date _
) As Boolean

    Dim holidaySheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim storedValue As Variant

    If Not WorksheetExists(SHEET_HOLIDAY) Then Exit Function

