Private Function GetSafeLongValue( _
    ByVal targetValue As Variant _
) As Long

    On Error GoTo InvalidValue

    If Not IsNumeric(targetValue) Then Exit Function
    If CDbl(targetValue) <> Fix(CDbl(targetValue)) Then Exit Function
    If CDbl(targetValue) < 0 Then Exit Function
    If CDbl(targetValue) > 2147483647# Then Exit Function

    GetSafeLongValue = CLng(targetValue)

InvalidValue:
End Function

