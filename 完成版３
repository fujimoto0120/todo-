Private Function DailyRowIsEnabled( _
    ByVal dailySheet As Worksheet, _
    ByVal rowNumber As Long _
) As Boolean

    Dim targetValue As Variant
    Dim normalizedValue As String

    targetValue = GetSafeCellValue(dailySheet.Cells( _
        rowNumber, COL_DAILY_ENABLED))

    If VarType(targetValue) = vbBoolean Then
        DailyRowIsEnabled = CBool(targetValue)
        Exit Function
    End If

    normalizedValue = UCase$(Trim$(CStr(targetValue)))

    DailyRowIsEnabled = _
        (normalizedValue = "TRUE" _
        Or normalizedValue = "はい" _
        Or normalizedValue = "1")
End Function

