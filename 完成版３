Private Function GetExistingMaxIdNumber( _
    ByVal sheetName As String, _
    ByVal idColumn As Long, _
    ByVal idPrefix As String _
) As Long

    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim idValue As String
    Dim numberPart As String
    Dim currentNumber As Long

    Set targetSheet = ThisWorkbook.Worksheets(sheetName)
    lastRow = GetLastDataRow(targetSheet, idColumn)

    For rowNumber = DATA_FIRST_ROW To lastRow
        idValue = Trim$(CStr(GetSafeCellValue( _
            targetSheet.Cells(rowNumber, idColumn))))

        If Len(idValue) = Len(idPrefix) + ID_NUMBER_DIGITS Then
            If Left$(idValue, Len(idPrefix)) = idPrefix Then
                numberPart = Mid$(idValue, Len(idPrefix) + 1)

                If numberPart Like String$(ID_NUMBER_DIGITS, "#") Then
                    currentNumber = CLng(numberPart)

                    If currentNumber > GetExistingMaxIdNumber Then
                        GetExistingMaxIdNumber = currentNumber
                    End If
                End If
            End If
        End If
    Next rowNumber
End Function

Private Function GetSavedNextIdNumber(ByVal counterKey As String) As Long
    Dim systemSheet As Worksheet
    Dim foundCell As Range
    Dim rawValue As Variant

    GetSavedNextIdNumber = 1
    Set systemSheet = ThisWorkbook.Worksheets(SHEET_SYSTEM)

    Set foundCell = systemSheet.Columns(COL_SYSTEM_KEY).Find( _
        What:=counterKey, _
        After:=systemSheet.Cells(1, COL_SYSTEM_KEY), _
        LookIn:=xlValues, _
        LookAt:=xlWhole, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlNext, _
        MatchCase:=False)

    If foundCell Is Nothing Then Exit Function

    rawValue = systemSheet.Cells(foundCell.Row, COL_SYSTEM_VALUE).Value

    If IsNumeric(rawValue) Then
        If CDbl(rawValue) = Fix(CDbl(rawValue)) Then
            If CDbl(rawValue) >= 1 And CDbl(rawValue) <= ID_NUMBER_MAX + 1# Then
                GetSavedNextIdNumber = CLng(rawValue)
            End If
        End If
    End If
End Function

Private Sub SaveNextIdNumber( _
