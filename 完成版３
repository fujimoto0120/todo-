Private Sub EnsureDateDropdownMonthsAtLeastDefault( _
    ByVal settingsSheet As Worksheet _
)
    Dim targetRow As Long
    Dim currentValue As Variant

    targetRow = FindSettingRow(settingsSheet, SETTING_DATE_DROPDOWN_MONTHS)
    If targetRow = 0 Then Exit Sub

    currentValue = GetSafeCellValue(settingsSheet.Cells( _
        targetRow, COL_SETTING_VALUE))

    If Not IsNumeric(currentValue) Then
        settingsSheet.Cells(targetRow, COL_SETTING_VALUE).Value = _
            DEFAULT_DATE_DROPDOWN_MONTHS
    ElseIf CLng(currentValue) < DEFAULT_DATE_DROPDOWN_MONTHS Then
        settingsSheet.Cells(targetRow, COL_SETTING_VALUE).Value = _
            DEFAULT_DATE_DROPDOWN_MONTHS
    End If
End Sub
