Public Function ValidateTodoRow( _
    ByVal targetSheet As Worksheet, _
    ByVal rowNumber As Long, _
    ByRef errorMessage As String, _
    Optional ByVal normalizeValues As Boolean = True _
) As Boolean

    Dim todoDue As Date
    Dim actualDue As Date
    Dim taskType As String
    Dim taskId As String
    Dim priorityText As String
    Dim descriptionText As String
    Dim createdValue As Variant
    Dim sourceRowValue As Variant

    errorMessage = vbNullString

    If rowNumber < DATA_FIRST_ROW Then
        errorMessage = "データ行ではありません。"
        Exit Function
    End If

    If Not IsValidExcelDate(targetSheet.Cells( _
        rowNumber, COL_TODO_DUE).Value) Then

        errorMessage = "ToDo納期が日付ではありません。"
        Exit Function
    End If

    todoDue = DateOnlyValue(targetSheet.Cells( _
        rowNumber, COL_TODO_DUE).Value)

    If normalizeValues Then
        targetSheet.Cells( _
            rowNumber, COL_TODO_DUE).Value = todoDue
    End If

    taskType = Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_TASK_TYPE))))

    If taskType <> TASK_TYPE_MANUAL _
        And taskType <> TASK_TYPE_DAILY _
        And taskType <> TASK_TYPE_RECURRING Then

        errorMessage = "業務区分が不正です。"
        Exit Function
    End If

    If taskType = TASK_TYPE_DAILY _
        Or taskType = TASK_TYPE_RECURRING Then

        actualDue = todoDue

        If normalizeValues Then
            targetSheet.Cells( _
                rowNumber, COL_TODO_ACTUAL_DUE).Value = actualDue
        Else
            If Not IsValidExcelDate(targetSheet.Cells( _
                rowNumber, COL_TODO_ACTUAL_DUE).Value) Then

                errorMessage = "実納期が日付ではありません。"
                Exit Function
            End If

            If DateOnlyValue(targetSheet.Cells( _
                rowNumber, COL_TODO_ACTUAL_DUE).Value) <> _
                todoDue Then

                errorMessage = _
                    "毎日業務または定期業務の実納期がToDo納期と異なります。"

                Exit Function
            End If
        End If
    Else
        If Len(Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
            rowNumber, COL_TODO_ACTUAL_DUE))))) = 0 Then

            If Not normalizeValues Then
                errorMessage = "実納期が空欄です。"
                Exit Function
            End If

            actualDue = todoDue
            targetSheet.Cells( _
                rowNumber, COL_TODO_ACTUAL_DUE).Value = actualDue
        ElseIf IsValidExcelDate(targetSheet.Cells( _
            rowNumber, COL_TODO_ACTUAL_DUE).Value) Then

            actualDue = DateOnlyValue(targetSheet.Cells( _
                rowNumber, COL_TODO_ACTUAL_DUE).Value)

            If normalizeValues Then
                targetSheet.Cells( _
                    rowNumber, COL_TODO_ACTUAL_DUE).Value = actualDue
            End If
        Else
            errorMessage = "実納期が日付ではありません。"
            Exit Function
        End If

        If actualDue < todoDue Then
            errorMessage = "実納期がToDo納期より前です。"
            Exit Function
        End If
    End If

    descriptionText = Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_DESCRIPTION))))

    If Len(descriptionText) = 0 Then
        errorMessage = "行うことが空欄です。"
        Exit Function
    End If

    priorityText = Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_PRIORITY))))

    If Not IsAllowedPriority(priorityText) Then
        errorMessage = "優先度が不正です。"
        Exit Function
    End If

    taskId = Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_TASK_ID))))

    If taskType <> TASK_TYPE_MANUAL Then
        If Len(taskId) = 0 Then
            errorMessage = "業務IDが空欄です。"
            Exit Function
        End If

        If Not IsValidExcelDate(targetSheet.Cells( _
            rowNumber, COL_TODO_ORIGINAL_DATE).Value) Then

            errorMessage = "本来の予定日が不正です。"
            Exit Function
        End If
    End If

    createdValue = GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_CREATED_AT))

    If Not IsDate(createdValue) Then
        errorMessage = "登録日時が不正です。"
        Exit Function
    End If

    sourceRowValue = GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_SOURCE_ROW))

    If Not IsValidDataRowNumber( _
        targetSheet, sourceRowValue) Then

        errorMessage = "登録元行番号が不正です。"
        Exit Function
    End If

    ValidateTodoRow = True
End Function

Public Sub SortTodoListCore()
    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim dataCount As Long
    Dim columnCount As Long
    Dim rowNumber As Long
    Dim sourceColumn As Long
    Dim dataIndex As Long
    Dim previousIndex As Long
    Dim dataValues() As Variant
    Dim temporaryValues() As Variant

    If Not WorksheetExists(SHEET_TODO_LIST) Then
        Err.Raise vbObjectError + 1100, _
            "SortTodoListCore", _
            "ToDoリストシートがありません。"
    End If

    Set targetSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    lastRow = GetLastDataRow(targetSheet)

    If lastRow < DATA_FIRST_ROW Then Exit Sub

    For rowNumber = DATA_FIRST_ROW To lastRow
        If TodoRowHasData(targetSheet, rowNumber) Then
            dataCount = dataCount + 1
        End If
    Next rowNumber

    If dataCount = 0 Then Exit Sub

    columnCount = COL_TODO_LAST - COL_TODO_FIRST + 1
    ReDim dataValues(1 To dataCount, 1 To columnCount)
    ReDim temporaryValues(1 To columnCount)

    dataIndex = 0

    For rowNumber = DATA_FIRST_ROW To lastRow
        If TodoRowHasData(targetSheet, rowNumber) Then
            dataIndex = dataIndex + 1

            For sourceColumn = 1 To columnCount
                dataValues(dataIndex, sourceColumn) = _
                    targetSheet.Cells( _
                        rowNumber, _
                        COL_TODO_FIRST + sourceColumn - 1).Value
            Next sourceColumn
        End If
    Next rowNumber

    For dataIndex = 2 To dataCount
        For sourceColumn = 1 To columnCount
            temporaryValues(sourceColumn) = _
                dataValues(dataIndex, sourceColumn)
        Next sourceColumn

        previousIndex = dataIndex - 1

        Do While previousIndex >= 1
            If CompareTodoRows( _
                dataValues, _
                previousIndex, _
                temporaryValues) <= 0 Then

                Exit Do
            End If

            For sourceColumn = 1 To columnCount
                dataValues( _
                    previousIndex + 1, _
                    sourceColumn) = _
                    dataValues(previousIndex, sourceColumn)
            Next sourceColumn

            previousIndex = previousIndex - 1
        Loop

        For sourceColumn = 1 To columnCount
            dataValues( _
                previousIndex + 1, _
                sourceColumn) = temporaryValues(sourceColumn)
        Next sourceColumn
    Next dataIndex

    targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_FIRST), _
        targetSheet.Cells(lastRow, COL_TODO_LAST)).ClearContents

    targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_FIRST), _
        targetSheet.Cells( _
            DATA_FIRST_ROW + dataCount - 1, _
            COL_TODO_LAST)).Value = dataValues
End Sub

Private Function CompareTodoRows( _
    ByRef dataValues() As Variant, _
    ByVal leftIndex As Long, _
    ByRef rightValues() As Variant _
) As Long

    Dim comparisonValue As Long

    comparisonValue = CompareDateValues( _
        dataValues( _
            leftIndex, _
            COL_TODO_DUE - COL_TODO_FIRST + 1), _
        rightValues( _
            COL_TODO_DUE - COL_TODO_FIRST + 1))

    If comparisonValue <> 0 Then
        CompareTodoRows = comparisonValue
        Exit Function
    End If

    comparisonValue = CompareLongValues( _
        GetPrioritySortValue(dataValues( _
            leftIndex, _
            COL_TODO_PRIORITY - COL_TODO_FIRST + 1)), _
        GetPrioritySortValue(rightValues( _
            COL_TODO_PRIORITY - COL_TODO_FIRST + 1)))

    If comparisonValue <> 0 Then
        CompareTodoRows = comparisonValue
        Exit Function
    End If

    comparisonValue = CompareDateValues( _
        dataValues( _
            leftIndex, _
            COL_TODO_ACTUAL_DUE - COL_TODO_FIRST + 1), _
        rightValues( _
            COL_TODO_ACTUAL_DUE - COL_TODO_FIRST + 1))

    If comparisonValue <> 0 Then
        CompareTodoRows = comparisonValue
        Exit Function
    End If

    CompareTodoRows = CompareDateValues( _
        dataValues( _
            leftIndex, _
            COL_TODO_CREATED_AT - COL_TODO_FIRST + 1), _
        rightValues( _
            COL_TODO_CREATED_AT - COL_TODO_FIRST + 1))
End Function

Private Function CompareDateValues( _
    ByVal leftValue As Variant, _
    ByVal rightValue As Variant _
) As Long

    Dim leftNumber As Double
    Dim rightNumber As Double

    leftNumber = GetDateSortNumber(leftValue)
    rightNumber = GetDateSortNumber(rightValue)

    If leftNumber < rightNumber Then
        CompareDateValues = -1
    ElseIf leftNumber > rightNumber Then
        CompareDateValues = 1
    End If
End Function

Private Function CompareLongValues( _
    ByVal leftValue As Long, _
    ByVal rightValue As Long _
) As Long

    If leftValue < rightValue Then
        CompareLongValues = -1
    ElseIf leftValue > rightValue Then
        CompareLongValues = 1
    End If
End Function

Private Function GetDateSortNumber( _
    ByVal targetValue As Variant _
) As Double

    If IsValidExcelDate(targetValue) Then
        GetDateSortNumber = CDbl(CDate(targetValue))
    Else
        GetDateSortNumber = 1E+99
    End If
End Function

Public Sub RefreshTodoDisplayCore()
    Dim targetSheet As Worksheet
    Dim lastLayoutRow As Long
    Dim lastDataRow As Long
    Dim displayRange As Range

    If Not WorksheetExists(SHEET_TODO_LIST) Then Exit Sub
    Set targetSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)

    lastLayoutRow = DATA_FIRST_ROW + ABSOLUTE_TODO_MAX - 1
    lastDataRow = GetLastDataRow(targetSheet)

    Set displayRange = targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_DUE), _
        targetSheet.Cells(lastLayoutRow, COL_TODO_CHECK))

    With displayRange
        .Interior.Color = COLOR_WHITE
        .Font.Color = COLOR_TEXT_NAVY
        .Font.Name = UI_FONT_NAME
        .Font.Size = 11
        .VerticalAlignment = xlCenter
        .Borders.LineStyle = xlNone
    End With

    targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_DUE), _
        targetSheet.Cells(lastLayoutRow, COL_TODO_ACTUAL_DUE)).NumberFormat = _
        DATE_DISPLAY_FORMAT

    targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_NO), _
        targetSheet.Cells(lastLayoutRow, COL_TODO_NO)).NumberFormat = NO_DISPLAY_FORMAT

    targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_CHECK), _
        targetSheet.Cells(lastLayoutRow, COL_TODO_CHECK)).HorizontalAlignment = xlCenter

    If lastDataRow >= DATA_FIRST_ROW Then
        ApplyTodoBorders targetSheet.Range( _
            targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_DUE), _
            targetSheet.Cells(lastDataRow, COL_TODO_CHECK))
    End If

    ApplyTodoDateConditionalFormatting targetSheet, lastLayoutRow
End Sub
Private Function TodoRowHasData( _
    ByVal targetSheet As Worksheet, _
    ByVal rowNumber As Long _
) As Boolean

    TodoRowHasData = _
        (Application.CountA(targetSheet.Range( _
            targetSheet.Cells(rowNumber, COL_TODO_FIRST), _
            targetSheet.Cells(rowNumber, COL_TODO_LAST))) > 0)
End Function

Private Function IsTodoRowPendingValidation( _
    ByVal targetSheet As Worksheet, _
    ByVal rowNumber As Long _
) As Boolean

    Dim processStatus As String
    Dim previousKey As String

    processStatus = Trim$(CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_PROCESS_STATUS))))

    If processStatus = PROCESS_STATUS_UNCONFIRMED Then
        IsTodoRowPendingValidation = True
        Exit Function
    End If

    previousKey = CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_PREVIOUS_KEY)))

    IsTodoRowPendingValidation = _
        (BuildTodoDataKey(targetSheet, rowNumber) <> previousKey)
End Function

Public Function IsAllowedPriority( _
    ByVal priorityText As String _
) As Boolean

    Select Case Trim$(priorityText)
        Case vbNullString, _
            PRIORITY_HIGH, _
            PRIORITY_MEDIUM, _
            PRIORITY_LOW

            IsAllowedPriority = True
    End Select
End Function

Private Function IsValidDataRowNumber( _
    ByVal targetSheet As Worksheet, _
    ByVal targetValue As Variant _
) As Boolean

    Dim numericValue As Double

    On Error GoTo InvalidValue

    If Not IsNumeric(targetValue) Then Exit Function

    numericValue = CDbl(targetValue)

    If numericValue <> Fix(numericValue) Then Exit Function
    If numericValue < DATA_FIRST_ROW Then Exit Function
    If numericValue > targetSheet.Rows.Count Then Exit Function

    IsValidDataRowNumber = True
    Exit Function

InvalidValue:
End Function

Public Function BuildTodoDataKey( _
    ByVal targetSheet As Worksheet, _
    ByVal rowNumber As Long _
) As String

    Dim todoDateText As String
    Dim actualDateText As String
    Dim noText As String
    Dim descriptionText As String

    If IsValidExcelDate(targetSheet.Cells( _
        rowNumber, COL_TODO_DUE).Value) Then

        todoDateText = Format$(DateOnlyValue(targetSheet.Cells( _
            rowNumber, COL_TODO_DUE).Value), "yyyymmdd")
    End If

    If IsValidExcelDate(targetSheet.Cells( _
        rowNumber, COL_TODO_ACTUAL_DUE).Value) Then

        actualDateText = Format$(DateOnlyValue(targetSheet.Cells( _
            rowNumber, COL_TODO_ACTUAL_DUE).Value), "yyyymmdd")
    End If

    noText = CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_NO)))

    descriptionText = CStr(GetSafeCellValue(targetSheet.Cells( _
        rowNumber, COL_TODO_DESCRIPTION)))

    BuildTodoDataKey = _
        todoDateText & "|" & _
        actualDateText & "|" & _
        noText & "|" & _
        descriptionText
End Function

Private Sub ResetManualInputValues( _
    ByVal inputSheet As Worksheet _
)

    With inputSheet
        .Cells(TODO_ADD_INPUT_ROW, COL_ADD_TODO_DUE).Value = Date
        .Cells(TODO_ADD_INPUT_ROW, COL_ADD_ACTUAL_DUE).Value = Date

        .Range( _
            .Cells(TODO_ADD_INPUT_ROW, COL_ADD_NO), _
            .Cells(TODO_ADD_INPUT_ROW, COL_ADD_PRIORITY)).ClearContents
    End With

    ResetManualInputColors inputSheet
End Sub

Private Sub ResetManualInputColors( _
    ByVal inputSheet As Worksheet _
)

    With inputSheet.Range( _
        inputSheet.Cells(TODO_ADD_INPUT_ROW, COL_ADD_TODO_DUE), _
        inputSheet.Cells(TODO_ADD_INPUT_ROW, COL_ADD_PRIORITY))

        .Interior.Color = COLOR_INPUT_BACKGROUND
        .Font.Color = COLOR_TEXT_NAVY
    End With
End Sub

Private Sub MarkInputError(ByVal targetCell As Range)
    targetCell.Interior.Color = COLOR_ERROR_BACKGROUND
    targetCell.Font.Color = COLOR_ERROR_TEXT
End Sub

Private Sub ClearTodoErrorColors( _
    ByVal targetSheet As Worksheet _
)

    Dim lastLayoutRow As Long

    lastLayoutRow = DATA_FIRST_ROW + ABSOLUTE_TODO_MAX - 1

    With targetSheet.Range( _
