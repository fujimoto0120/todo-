' Excelの状態を確実に元へ戻すために使う
Public Type TExcelState
    ScreenUpdating As Boolean
    EnableEvents As Boolean
    Calculation As XlCalculation
    DisplayAlerts As Boolean
End Type

' Common
' 共通で使う小さな処理をここにまとめる

Public Sub CaptureExcelState(ByRef savedState As TExcelState)
    With Application
        savedState.ScreenUpdating = .ScreenUpdating
        savedState.EnableEvents = .EnableEvents
        savedState.Calculation = .Calculation
        savedState.DisplayAlerts = .DisplayAlerts
    End With
End Sub

Public Sub RestoreExcelState(ByRef savedState As TExcelState)
    On Error Resume Next

    With Application
        .ScreenUpdating = savedState.ScreenUpdating
        .EnableEvents = savedState.EnableEvents
        .Calculation = savedState.Calculation
        .DisplayAlerts = savedState.DisplayAlerts
    End With

    On Error GoTo 0
End Sub

Public Function WorksheetExists(ByVal sheetName As String) As Boolean

    Dim targetSheet As Object

    On Error Resume Next
    Set targetSheet = ThisWorkbook.Worksheets(sheetName)
    On Error GoTo 0

    WorksheetExists = Not targetSheet Is Nothing
End Function

Public Function GetLastDataRow( _
    ByVal targetSheet As Worksheet, _
    Optional ByVal keyColumn As Long = 0, _
    Optional ByVal firstDataRow As Long = DATA_FIRST_ROW _
) As Long

    Dim foundCell As Range
    Dim lastRow As Long

    If keyColumn > 0 Then
        lastRow = targetSheet.Cells(targetSheet.Rows.Count, keyColumn).End(xlUp).Row
    Else
        Set foundCell = targetSheet.Cells.Find( _
            What:="*", _
            After:=targetSheet.Cells(1, 1), _
            LookIn:=xlFormulas, _
            LookAt:=xlPart, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlPrevious, _
            MatchCase:=False)

        If foundCell Is Nothing Then
            lastRow = firstDataRow - 1
        Else
            lastRow = foundCell.Row
        End If
    End If

    If lastRow < firstDataRow Then
        GetLastDataRow = firstDataRow - 1
    Else
        GetLastDataRow = lastRow
    End If
End Function

Public Function GetNextDataRow( _
    ByVal targetSheet As Worksheet, _
    Optional ByVal keyColumn As Long = 0, _
    Optional ByVal firstDataRow As Long = DATA_FIRST_ROW _
) As Long

    Dim lastRow As Long

    lastRow = GetLastDataRow(targetSheet, keyColumn, firstDataRow)

    If lastRow < firstDataRow Then
        GetNextDataRow = firstDataRow
    Else
        GetNextDataRow = lastRow + 1
    End If
End Function

Public Function GetSafeCellValue(ByVal targetCell As Range) As Variant
    If targetCell Is Nothing Then
        GetSafeCellValue = Empty
    ElseIf IsError(targetCell.Value) Then
        GetSafeCellValue = Empty
    Else
        GetSafeCellValue = targetCell.Value
    End If
End Function

Public Function IsValidExcelDate(ByVal targetValue As Variant) As Boolean
    Dim convertedDate As Date

    If IsError(targetValue) Then Exit Function
    If IsEmpty(targetValue) Then Exit Function
    If VarType(targetValue) = vbBoolean Then Exit Function
    If Len(Trim$(CStr(targetValue))) = 0 Then Exit Function
    If Not IsDate(targetValue) Then Exit Function

    On Error GoTo InvalidDate
    convertedDate = CDate(targetValue)

    If Year(convertedDate) < 1900 Then Exit Function
    If Year(convertedDate) > 9999 Then Exit Function

    IsValidExcelDate = True
    Exit Function

InvalidDate:
    IsValidExcelDate = False
End Function

Public Function DateOnlyValue(ByVal targetValue As Variant) As Date
    If Not IsValidExcelDate(targetValue) Then
        Err.Raise vbObjectError + 1000, "DateOnlyValue", "日付として認識できない値です。"
    End If

    DateOnlyValue = DateValue(CDate(targetValue))
End Function

Public Function GetSettingLong( _
    ByVal settingName As String, _
    ByVal defaultValue As Long, _
    Optional ByVal minimumValue As Long = 0, _
    Optional ByVal maximumValue As Long = 0, _
    Optional ByVal showWarning As Boolean = True _
) As Long

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim numericValue As Double
    Dim isValid As Boolean

    rawValue = GetSettingRawValue(settingName, settingFound)

    If settingFound Then
        If Not IsError(rawValue) Then
            If IsNumeric(rawValue) Then
                numericValue = CDbl(rawValue)
                isValid = (numericValue = Fix(numericValue))

                If isValid Then
                    If numericValue < -2147483648# _
                        Or numericValue > 2147483647# Then

                        isValid = False
                    End If
                End If

                If isValid Then
                    If numericValue < minimumValue Then
                        isValid = False
                    End If

                    If maximumValue > 0 Then
                        If numericValue > maximumValue Then
                            isValid = False
                        End If
                    End If
                End If
            End If
        End If
    End If

    If isValid Then
        GetSettingLong = CLng(numericValue)
    Else
        GetSettingLong = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning settingName, CStr(defaultValue)
        End If
    End If
End Function

Public Function GetSettingBoolean( _
    ByVal settingName As String, _
    ByVal defaultValue As Boolean, _
    Optional ByVal showWarning As Boolean = True _
) As Boolean

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim normalizedValue As String
    Dim isValid As Boolean

    rawValue = GetSettingRawValue(settingName, settingFound)

    If settingFound Then
        If Not IsError(rawValue) Then
            If VarType(rawValue) = vbBoolean Then
                GetSettingBoolean = CBool(rawValue)
                Exit Function
            End If

            normalizedValue = UCase$(Trim$(CStr(rawValue)))

            Select Case normalizedValue
                Case "はい", "TRUE", "1", "表示"
                    GetSettingBoolean = True
                    isValid = True
                Case "いいえ", "FALSE", "0", "非表示"
                    GetSettingBoolean = False
                    isValid = True
            End Select
        End If
    End If

    If Not isValid Then
        GetSettingBoolean = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning settingName, IIf(defaultValue, "はい", "いいえ")
        End If
    End If
End Function

Public Function GetSettingText( _
    ByVal settingName As String, _
    ByVal defaultValue As String, _
    Optional ByVal showWarning As Boolean = True _
) As String

    Dim rawValue As Variant
    Dim settingFound As Boolean
    Dim normalizedValue As String

    rawValue = GetSettingRawValue(settingName, settingFound)

    If settingFound Then
        If Not IsError(rawValue) Then
            normalizedValue = Trim$(CStr(rawValue))
        End If
    End If

    If Len(normalizedValue) > 0 Then
        GetSettingText = normalizedValue
    Else
        GetSettingText = defaultValue

        If settingFound And showWarning Then
            ShowInvalidSettingWarning settingName, defaultValue
        End If
    End If
End Function

Public Function GetDateDropdownEndDate(ByVal startDate As Date) As Date
    Dim monthCount As Long

    monthCount = GetSettingLong( _
        SETTING_DATE_DROPDOWN_MONTHS, _
        DEFAULT_DATE_DROPDOWN_MONTHS, _
        1)

    On Error GoTo DateError
    GetDateDropdownEndDate = DateAdd("m", monthCount, DateValue(startDate))
    Exit Function

DateError:
    Err.Raise vbObjectError + 1001, "GetDateDropdownEndDate", _
        "日付プルダウンの終了日を計算できません。"
End Function

Public Function GetPrioritySortValue(ByVal priorityValue As Variant) As Long
    Dim normalizedValue As String

    If IsError(priorityValue) Then
        GetPrioritySortValue = PRIORITY_SORT_BLANK
        Exit Function
    End If

    If IsEmpty(priorityValue) Then
        GetPrioritySortValue = PRIORITY_SORT_BLANK
        Exit Function
    End If

    normalizedValue = Trim$(CStr(priorityValue))

    Select Case normalizedValue
        Case PRIORITY_HIGH
            GetPrioritySortValue = PRIORITY_SORT_HIGH
        Case PRIORITY_MEDIUM
            GetPrioritySortValue = PRIORITY_SORT_MEDIUM
        Case PRIORITY_LOW
            GetPrioritySortValue = PRIORITY_SORT_LOW
        Case vbNullString
            GetPrioritySortValue = PRIORITY_SORT_BLANK
        Case Else
            GetPrioritySortValue = PRIORITY_SORT_INVALID
    End Select
End Function

Public Function GetTodoDataCount() As Long
    Dim targetSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long

    If Not WorksheetExists(SHEET_TODO_LIST) Then Exit Function

    Set targetSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    lastRow = GetLastDataRow(targetSheet)

    For rowNumber = DATA_FIRST_ROW To lastRow
        If Application.CountA( _
            targetSheet.Range( _
                targetSheet.Cells(rowNumber, COL_TODO_FIRST), _
                targetSheet.Cells(rowNumber, COL_TODO_LAST))) > 0 Then

            GetTodoDataCount = GetTodoDataCount + 1
        End If
    Next rowNumber
End Function

Public Function CanAddTodoRows( _
    ByVal requiredCount As Long, _
    Optional ByVal showWarning As Boolean = True _
) As Boolean

    Dim todoLimit As Long
    Dim currentCount As Long

    If requiredCount <= 0 Then
        CanAddTodoRows = True
        Exit Function
    End If

    If Not WorksheetExists(SHEET_TODO_LIST) Then
        If showWarning Then
            MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        End If
        Exit Function
    End If

    todoLimit = GetSettingLong( _
        SETTING_TODO_MAX, _
        DEFAULT_TODO_MAX, _
        1, _
        ABSOLUTE_TODO_MAX)

    currentCount = GetTodoDataCount()
    CanAddTodoRows = (currentCount + requiredCount <= todoLimit)

    If Not CanAddTodoRows And showWarning Then
        MsgBox MSG_TODO_LIMIT_REACHED & vbCrLf & _
            "現在：" & CStr(currentCount) & "件" & vbCrLf & _
            "上限：" & CStr(todoLimit) & "件", _
            vbExclamation, APP_TITLE
    End If
End Function

Public Function AppendTodoRecord( _
    ByVal todoDue As Date, _
    ByVal actualDue As Date, _
    ByVal noText As String, _
    ByVal descriptionText As String, _
    ByVal priorityText As String, _
    ByVal taskType As String, _
    ByVal taskId As String, _
    ByVal originalDate As Date, _
    ByVal sourceRow As Long _
) As Long

    Dim todoSheet As Worksheet
    Dim targetRow As Long
    Dim savedErrorNumber As Long
    Dim savedErrorText As String

    On Error GoTo ErrorHandler

    If Not WorksheetExists(SHEET_TODO_LIST) Then
        Err.Raise vbObjectError + 1010, _
            "AppendTodoRecord", _
            "ToDoリストシートがありません。"
    End If

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    targetRow = GetNextDataRow(todoSheet)

    With todoSheet
        .Cells(targetRow, COL_TODO_DUE).Value = _
            DateValue(todoDue)

        .Cells(targetRow, COL_TODO_ACTUAL_DUE).Value = _
            DateValue(actualDue)

        .Cells(targetRow, COL_TODO_NO).NumberFormat = _
            NO_DISPLAY_FORMAT

        .Cells(targetRow, COL_TODO_NO).Value = CStr(noText)
        .Cells(targetRow, COL_TODO_DESCRIPTION).Value = _
            CStr(descriptionText)

        .Cells(targetRow, COL_TODO_CHECK).ClearContents
        .Cells(targetRow, COL_TODO_PRIORITY).Value = _
            CStr(priorityText)

        .Cells(targetRow, COL_TODO_TASK_TYPE).Value = _
            CStr(taskType)

        .Cells(targetRow, COL_TODO_TASK_ID).NumberFormat = _
            NO_DISPLAY_FORMAT

        .Cells(targetRow, COL_TODO_TASK_ID).Value = _
            CStr(taskId)

        .Cells(targetRow, COL_TODO_ORIGINAL_DATE).Value = _
            DateValue(originalDate)

        .Cells(targetRow, COL_TODO_CREATED_AT).Value = Now
        .Cells(targetRow, COL_TODO_COMPLETED_AT).ClearContents
        .Cells(targetRow, COL_TODO_SOURCE_ROW).Value = sourceRow

        .Cells(targetRow, COL_TODO_PROCESS_STATUS).Value = _
            PROCESS_STATUS_CONFIRMED

        .Cells(targetRow, COL_TODO_PREVIOUS_KEY).Value = _
            BuildTodoDataKey(todoSheet, targetRow)
    End With

    AppendTodoRecord = targetRow
    Exit Function

ErrorHandler:
    savedErrorNumber = Err.Number
    savedErrorText = Err.Description

    On Error Resume Next

    If Not todoSheet Is Nothing _
        And targetRow >= DATA_FIRST_ROW Then

        todoSheet.Range( _
            todoSheet.Cells(targetRow, COL_TODO_FIRST), _
            todoSheet.Cells(targetRow, COL_TODO_LAST)).ClearContents
    End If

    On Error GoTo 0

    Err.Raise savedErrorNumber, _
        "AppendTodoRecord", _
        savedErrorText
End Function

Public Function FindOpenTodoRowByTaskId( _
    ByVal taskType As String, _
    ByVal taskId As String, _
    Optional ByVal originalDateValue As Variant _
) As Long

    Dim todoSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim storedOriginalDate As Variant

    If Len(Trim$(taskId)) = 0 Then Exit Function
    If Not WorksheetExists(SHEET_TODO_LIST) Then Exit Function

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    lastRow = GetLastDataRow(todoSheet)

    For rowNumber = DATA_FIRST_ROW To lastRow
        If Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
            rowNumber, COL_TODO_TASK_TYPE)))) = taskType _
        And Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
            rowNumber, COL_TODO_TASK_ID)))) = taskId Then

            If IsMissing(originalDateValue) Then
                FindOpenTodoRowByTaskId = rowNumber
                Exit Function
            End If

            storedOriginalDate = GetSafeCellValue( _
                todoSheet.Cells( _
                    rowNumber, COL_TODO_ORIGINAL_DATE))

            If IsValidExcelDate(storedOriginalDate) _
                And IsValidExcelDate(originalDateValue) Then

                If DateOnlyValue(storedOriginalDate) = _
                    DateOnlyValue(originalDateValue) Then

                    FindOpenTodoRowByTaskId = rowNumber
                    Exit Function
                End If
            End If
        End If
    Next rowNumber
