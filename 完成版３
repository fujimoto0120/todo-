Private Sub ApplyDailyChangesForManualMode()
    Dim dailySheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim changedRange As Range

    If Not WorksheetExists(SHEET_DAILY) Then Exit Sub

    Set dailySheet = ThisWorkbook.Worksheets(SHEET_DAILY)
    lastRow = GetLastDataRow(dailySheet)

    If lastRow > _
        DATA_FIRST_ROW + ABSOLUTE_DAILY_MAX - 1 Then

        lastRow = DATA_FIRST_ROW + ABSOLUTE_DAILY_MAX - 1
    End If

    If lastRow < DATA_FIRST_ROW Then Exit Sub

    For rowNumber = DATA_FIRST_ROW To lastRow
        Set changedRange = dailySheet.Range( _
            dailySheet.Cells( _
                rowNumber, COL_DAILY_NO), _
            dailySheet.Cells( _
                rowNumber, COL_DAILY_PRIORITY))

        HandleDailySheetChange changedRange
    Next rowNumber
