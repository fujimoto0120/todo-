            End If
        End If
    Next rowNumber
End Function

Public Function AdjustBusinessDate( _
    ByVal originalDate As Date, _
    ByVal adjustmentType As String _
) As Date

    Dim candidateDate As Date

    originalDate = DateValue(originalDate)

    If Not IsHoliday(originalDate) _
        Or adjustmentType = HOLIDAY_ADJUST_NONE Then

        AdjustBusinessDate = originalDate
        Exit Function
    End If

    candidateDate = originalDate

    Select Case adjustmentType
        Case HOLIDAY_ADJUST_PREVIOUS
            Do
                candidateDate = DateAdd("d", -1, candidateDate)
            Loop While IsHoliday(candidateDate)

        Case HOLIDAY_ADJUST_NEXT
            Do
                candidateDate = DateAdd("d", 1, candidateDate)
            Loop While IsHoliday(candidateDate)

        Case Else
            Err.Raise vbObjectError + 1300, _
                "AdjustBusinessDate", _
                "休日調整の指定が不正です。"
    End Select

    AdjustBusinessDate = candidateDate
End Function

Public Function AdjustBusinessDateWithinMonth( _
    ByVal originalDate As Date, _
    ByVal adjustmentType As String _
) As Date

    Dim candidateDate As Date
    Dim targetMonth As Long
    Dim targetYear As Long

    originalDate = DateValue(originalDate)
    targetYear = Year(originalDate)
    targetMonth = Month(originalDate)

    If Not IsHoliday(originalDate) _
        Or adjustmentType = HOLIDAY_ADJUST_NONE Then

        AdjustBusinessDateWithinMonth = originalDate
        Exit Function
    End If

    candidateDate = originalDate

    If adjustmentType = HOLIDAY_ADJUST_PREVIOUS Then
        Do
            candidateDate = DateAdd("d", -1, candidateDate)

            If Year(candidateDate) <> targetYear _
                Or Month(candidateDate) <> targetMonth Then

                candidateDate = originalDate

                Do
                    candidateDate = DateAdd("d", 1, candidateDate)

                    If Year(candidateDate) <> targetYear _
                        Or Month(candidateDate) <> targetMonth Then

                        Err.Raise vbObjectError + 1301, _
                            "AdjustBusinessDateWithinMonth", _
                            "同じ月内に営業日がありません。"
                    End If
                Loop While IsHoliday(candidateDate)

                Exit Do
            End If
        Loop While IsHoliday(candidateDate)

    ElseIf adjustmentType = HOLIDAY_ADJUST_NEXT Then
        Do
            candidateDate = DateAdd("d", 1, candidateDate)

            If Year(candidateDate) <> targetYear _
                Or Month(candidateDate) <> targetMonth Then

                candidateDate = originalDate

                Do
                    candidateDate = DateAdd("d", -1, candidateDate)

                    If Year(candidateDate) <> targetYear _
                        Or Month(candidateDate) <> targetMonth Then

                        Err.Raise vbObjectError + 1302, _
                            "AdjustBusinessDateWithinMonth", _
                            "同じ月内に営業日がありません。"
                    End If
                Loop While IsHoliday(candidateDate)

                Exit Do
            End If
        Loop While IsHoliday(candidateDate)

    Else
        Err.Raise vbObjectError + 1303, _
            "AdjustBusinessDateWithinMonth", _
            "休日調整の指定が不正です。"
    End If

    AdjustBusinessDateWithinMonth = candidateDate
End Function

Public Function CalculateNextRecurringDate( _
    ByVal settingsSheet As Worksheet, _
    ByVal settingRow As Long, _
    ByVal currentOriginalDate As Date _
) As Date

    Dim recurringType As String
    Dim weekdayNumber As Long
    Dim weekNumber As Long
    Dim dayNumber As Long
    Dim nextMonthDate As Date
    Dim missingDay As Boolean

    recurringType = Trim$(CStr(GetSafeCellValue( _
        settingsSheet.Cells( _
            settingRow, COL_RECURRING_TYPE))))

    currentOriginalDate = DateValue(currentOriginalDate)

    Select Case recurringType
        Case RECURRING_TYPE_DAILY
            CalculateNextRecurringDate = DateAdd("d", 1, currentOriginalDate)
            Do While IsHoliday(CalculateNextRecurringDate)
                CalculateNextRecurringDate = _
                    DateAdd("d", 1, CalculateNextRecurringDate)
            Loop

        Case RECURRING_TYPE_WEEKLY
            CalculateNextRecurringDate = _
                DateAdd("d", 7, currentOriginalDate)

        Case RECURRING_TYPE_MONTHLY_DAY
            dayNumber = GetTextInteger( _
                settingsSheet.Cells( _
                    settingRow, COL_RECURRING_DAY).Value, _
                1, _
                31)

            nextMonthDate = DateSerial( _
                Year(currentOriginalDate), _
                Month(currentOriginalDate) + 1, _
                1)

            CalculateNextRecurringDate = _
                CalculateMonthlyDay( _
                    Year(nextMonthDate), _
                    Month(nextMonthDate), _
                    dayNumber, _
                    missingDay)

        Case RECURRING_TYPE_NTH_WEEKDAY
            weekdayNumber = GetWeekdayNumber( _
                CStr(GetSafeCellValue(settingsSheet.Cells( _
                    settingRow, COL_RECURRING_WEEKDAY))))

            weekNumber = GetTextInteger( _
                settingsSheet.Cells( _
                    settingRow, COL_RECURRING_WEEK_NUMBER).Value, _
                1, _
                5)

            nextMonthDate = DateSerial( _
                Year(currentOriginalDate), _
                Month(currentOriginalDate) + 1, _
                1)

            CalculateNextRecurringDate = _
                CalculateNthWeekday( _
                    Year(nextMonthDate), _
                    Month(nextMonthDate), _
                    weekdayNumber, _
                    weekNumber)

        Case RECURRING_TYPE_LAST_WEEKDAY
            weekdayNumber = GetWeekdayNumber( _
                CStr(GetSafeCellValue(settingsSheet.Cells( _
                    settingRow, COL_RECURRING_WEEKDAY))))

            nextMonthDate = DateSerial( _
                Year(currentOriginalDate), _
                Month(currentOriginalDate) + 1, _
                1)

            CalculateNextRecurringDate = _
                CalculateLastWeekday( _
                    Year(nextMonthDate), _
                    Month(nextMonthDate), _
                    weekdayNumber)

        Case RECURRING_TYPE_MONTH_END, _
            RECURRING_TYPE_LAST_BUSINESS_DAY

            nextMonthDate = DateSerial( _
                Year(currentOriginalDate), _
                Month(currentOriginalDate) + 1, _
                1)

            CalculateNextRecurringDate = _
                CalculateMonthEnd( _
                    Year(nextMonthDate), _
                    Month(nextMonthDate))

        Case Else
            Err.Raise vbObjectError + 1304, _
                "CalculateNextRecurringDate", _
                "繰り返し種別が不正です。"
    End Select
End Function

Public Function CalculateRecurringDateOnOrAfter( _
    ByVal settingsSheet As Worksheet, _
    ByVal settingRow As Long, _
    ByVal anchorDate As Date _
) As Date

    Dim recurringType As String
    Dim candidateDate As Date
    Dim monthBase As Date
    Dim weekdayNumber As Long
    Dim weekNumber As Long
    Dim dayNumber As Long
    Dim missingDay As Boolean

    recurringType = Trim$(CStr(GetSafeCellValue( _
        settingsSheet.Cells( _
            settingRow, COL_RECURRING_TYPE))))

    anchorDate = DateValue(anchorDate)

    If recurringType = RECURRING_TYPE_DAILY Then
        candidateDate = anchorDate
        Do While IsHoliday(candidateDate)
            candidateDate = DateAdd("d", 1, candidateDate)
        Loop
        CalculateRecurringDateOnOrAfter = candidateDate
        Exit Function
    End If

    If recurringType = RECURRING_TYPE_WEEKLY Then
        weekdayNumber = GetWeekdayNumber( _
            CStr(GetSafeCellValue(settingsSheet.Cells( _
                settingRow, COL_RECURRING_WEEKDAY))))

        candidateDate = anchorDate

        Do While Weekday(candidateDate, vbSunday) <> weekdayNumber
            candidateDate = DateAdd("d", 1, candidateDate)
        Loop

        CalculateRecurringDateOnOrAfter = candidateDate
        Exit Function
    End If

    monthBase = DateSerial( _
        Year(anchorDate), Month(anchorDate), 1)

    Do
        Select Case recurringType
            Case RECURRING_TYPE_MONTHLY_DAY
                dayNumber = GetTextInteger( _
                    settingsSheet.Cells( _
                        settingRow, COL_RECURRING_DAY).Value, _
                    1, _
                    31)

                candidateDate = CalculateMonthlyDay( _
                    Year(monthBase), _
                    Month(monthBase), _
                    dayNumber, _
                    missingDay)

            Case RECURRING_TYPE_NTH_WEEKDAY
                weekdayNumber = GetWeekdayNumber( _
                    CStr(GetSafeCellValue(settingsSheet.Cells( _
                        settingRow, COL_RECURRING_WEEKDAY))))

                weekNumber = GetTextInteger( _
                    settingsSheet.Cells( _
                        settingRow, _
                        COL_RECURRING_WEEK_NUMBER).Value, _
                    1, _
                    5)

                candidateDate = CalculateNthWeekday( _
                    Year(monthBase), _
                    Month(monthBase), _
                    weekdayNumber, _
                    weekNumber)

            Case RECURRING_TYPE_LAST_WEEKDAY
                weekdayNumber = GetWeekdayNumber( _
                    CStr(GetSafeCellValue(settingsSheet.Cells( _
                        settingRow, COL_RECURRING_WEEKDAY))))

                candidateDate = CalculateLastWeekday( _
                    Year(monthBase), _
                    Month(monthBase), _
                    weekdayNumber)

            Case RECURRING_TYPE_MONTH_END, _
                RECURRING_TYPE_LAST_BUSINESS_DAY

                candidateDate = CalculateMonthEnd( _
                    Year(monthBase), Month(monthBase))

            Case Else
                Err.Raise vbObjectError + 1305, _
                    "CalculateRecurringDateOnOrAfter", _
                    "繰り返し種別が不正です。"
        End Select

        If candidateDate >= anchorDate Then
            CalculateRecurringDateOnOrAfter = candidateDate
            Exit Function
        End If

        monthBase = DateAdd("m", 1, monthBase)
    Loop
End Function

Public Function GetAdjustedRecurringDueDate( _
    ByVal settingsSheet As Worksheet, _
    ByVal settingRow As Long, _
    ByVal originalDate As Date _
) As Date

    Dim recurringType As String
    Dim adjustmentType As String
    Dim requestedDay As Long
    Dim monthEndDay As Long

    recurringType = Trim$(CStr(GetSafeCellValue( _
        settingsSheet.Cells( _
            settingRow, COL_RECURRING_TYPE))))

    adjustmentType = Trim$(CStr(GetSafeCellValue( _
        settingsSheet.Cells( _
            settingRow, _
            COL_RECURRING_HOLIDAY_ADJUSTMENT))))

    If recurringType = RECURRING_TYPE_DAILY Then
        GetAdjustedRecurringDueDate = DateValue(originalDate)
        Do While IsHoliday(GetAdjustedRecurringDueDate)
            GetAdjustedRecurringDueDate = _
                DateAdd("d", 1, GetAdjustedRecurringDueDate)
        Loop
        Exit Function
    End If

    If recurringType = RECURRING_TYPE_MONTH_END _
        Or recurringType = RECURRING_TYPE_LAST_BUSINESS_DAY Then

        GetAdjustedRecurringDueDate = _
            CalculateLastBusinessDay( _
                Year(originalDate), Month(originalDate))
        Exit Function
    End If

    If recurringType = RECURRING_TYPE_MONTHLY_DAY Then
        requestedDay = GetTextInteger( _
            settingsSheet.Cells( _
                settingRow, COL_RECURRING_DAY).Value, _
            1, _
            31)

        monthEndDay = Day(CalculateMonthEnd( _
            Year(originalDate), Month(originalDate)))

        If requestedDay > monthEndDay Then
            GetAdjustedRecurringDueDate = _
                CalculateLastBusinessDay( _
                    Year(originalDate), Month(originalDate))

            Exit Function
        End If
    End If

    GetAdjustedRecurringDueDate = _
        AdjustBusinessDateWithinMonth( _
            originalDate, adjustmentType)
End Function

Public Function CalculateNthWeekday( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long, _
    ByVal weekdayNumber As Long, _
    ByVal weekNumber As Long _
) As Date

    Dim firstDate As Date
    Dim candidateDate As Date
    Dim offsetDays As Long

    If weekNumber < 1 Or weekNumber > 5 Then
        Err.Raise vbObjectError + 1306, _
            "CalculateNthWeekday", _
            "週番号は1から5で指定してください。"
    End If

    firstDate = DateSerial(targetYear, targetMonth, 1)
    offsetDays = _
        (weekdayNumber - Weekday(firstDate, vbSunday) + 7) Mod 7

    candidateDate = _
        DateAdd("d", offsetDays + (weekNumber - 1) * 7, firstDate)

    If Month(candidateDate) <> targetMonth Then
        candidateDate = CalculateLastWeekday( _
            targetYear, targetMonth, weekdayNumber)
    End If

    CalculateNthWeekday = candidateDate
End Function

Public Function CalculateLastWeekday( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long, _
    ByVal weekdayNumber As Long _
) As Date

    Dim candidateDate As Date

    candidateDate = CalculateMonthEnd(targetYear, targetMonth)

    Do While Weekday(candidateDate, vbSunday) <> weekdayNumber
        candidateDate = DateAdd("d", -1, candidateDate)
    Loop

    CalculateLastWeekday = candidateDate
End Function

Public Function CalculateMonthEnd( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long _
) As Date

    CalculateMonthEnd = _
        DateSerial(targetYear, targetMonth + 1, 0)
End Function

Public Function CalculateLastBusinessDay( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long _
) As Date

    Dim candidateDate As Date

    candidateDate = CalculateMonthEnd(targetYear, targetMonth)

    Do While IsHoliday(candidateDate)
        candidateDate = DateAdd("d", -1, candidateDate)
    Loop

    CalculateLastBusinessDay = candidateDate
End Function

Public Function GetWeekdayNumber( _
    ByVal weekdayText As String _
) As Long

    Select Case Trim$(weekdayText)
        Case "日", "日曜", "日曜日"
            GetWeekdayNumber = vbSunday
        Case "月", "月曜", "月曜日"
            GetWeekdayNumber = vbMonday
        Case "火", "火曜", "火曜日"
            GetWeekdayNumber = vbTuesday
        Case "水", "水曜", "水曜日"
            GetWeekdayNumber = vbWednesday
        Case "木", "木曜", "木曜日"
            GetWeekdayNumber = vbThursday
        Case "金", "金曜", "金曜日"
            GetWeekdayNumber = vbFriday
        Case "土", "土曜", "土曜日"
            GetWeekdayNumber = vbSaturday
        Case Else
            Err.Raise vbObjectError + 1307, _
                "GetWeekdayNumber", _
                "曜日の指定が不正です。"
    End Select
End Function

Public Function GetTextInteger( _
    ByVal targetValue As Variant, _
    ByVal minimumValue As Long, _
    ByVal maximumValue As Long _
) As Long

    Dim textValue As String
    Dim numericValue As Double

    On Error GoTo InvalidValue

    If IsError(targetValue) Then GoTo InvalidValue
    If IsEmpty(targetValue) Then GoTo InvalidValue

    textValue = Trim$(CStr(targetValue))
    If Len(textValue) = 0 Then GoTo InvalidValue
    If Not IsNumeric(textValue) Then GoTo InvalidValue

    numericValue = CDbl(textValue)

    If numericValue <> Fix(numericValue) Then GoTo InvalidValue
    If numericValue < minimumValue Then GoTo InvalidValue
    If numericValue > maximumValue Then GoTo InvalidValue

    GetTextInteger = CLng(numericValue)
    Exit Function

InvalidValue:
    Err.Raise vbObjectError + 1308, _
        "GetTextInteger", _
        CStr(minimumValue) & "から" & _
        CStr(maximumValue) & _
        "の整数を入力してください。"
End Function

Private Function CalculateMonthlyDay( _
    ByVal targetYear As Long, _
    ByVal targetMonth As Long, _
    ByVal requestedDay As Long, _
    ByRef missingDay As Boolean _
) As Date

    Dim lastDay As Long

    lastDay = Day(CalculateMonthEnd(targetYear, targetMonth))
    missingDay = (requestedDay > lastDay)

    If missingDay Then
        CalculateMonthlyDay = _
            DateSerial(targetYear, targetMonth, lastDay)
    Else
        CalculateMonthlyDay = _
            DateSerial(targetYear, targetMonth, requestedDay)
    End If
End Function

