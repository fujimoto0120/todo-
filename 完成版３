Private Sub ApplyTodoDateConditionalFormatting( _
    ByVal targetSheet As Worksheet, _
    ByVal lastLayoutRow As Long _
)
    Dim targetRange As Range
    Dim condition As FormatCondition
    Dim changeFormula As String

    Set targetRange = targetSheet.Range( _
        targetSheet.Cells(DATA_FIRST_ROW, COL_TODO_DUE), _
        targetSheet.Cells(lastLayoutRow, COL_TODO_CHECK))

    targetRange.FormatConditions.Delete

    Set condition = targetRange.FormatConditions.Add( _
        Type:=xlExpression, _
        Formula1:="=AND(ISNUMBER($B3),$B3<TODAY())")
    condition.Interior.Color = COLOR_DUE_OVERDUE_BACKGROUND
    condition.Font.Color = COLOR_ERROR_TEXT

    Set condition = targetRange.FormatConditions.Add( _
        Type:=xlExpression, _
        Formula1:="=AND(ISNUMBER($B3),$B3=TODAY()+1)")
    condition.Interior.Color = COLOR_DUE_TOMORROW_BACKGROUND
    condition.Font.Bold = True

    Set condition = targetRange.FormatConditions.Add( _
        Type:=xlExpression, _
        Formula1:="=AND(ISNUMBER($B3),$B3=TODAY())")
    condition.Interior.Color = COLOR_DUE_TODAY_BACKGROUND
    condition.Font.Color = COLOR_ERROR_TEXT
    condition.Font.Bold = True

    changeFormula = _
        "=AND(COUNTA($B3:$E3)>0,OR($N3=""" & _
        PROCESS_STATUS_UNCONFIRMED & _
        """,IFERROR(TEXT($B3,""yyyymmdd""),"""")&""|""&" & _
        "IFERROR(TEXT($C3,""yyyymmdd""),"""")&""|""&$D3&""|""&$E3<>$O3))"

    Set condition = targetRange.FormatConditions.Add( _
        Type:=xlExpression, Formula1:=changeFormula)
    condition.Interior.Color = COLOR_CHANGED_BACKGROUND
    condition.Font.Color = COLOR_TEXT_NAVY
    condition.Font.Bold = True
    condition.StopIfTrue = True
    condition.SetFirstPriority
End Sub
