Private Sub ApplySettingsValidation( _
    ByVal settingsSheet As Worksheet _
)

    Dim targetRow As Long

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_COMPLETED_RETENTION_DAYS)

    If targetRow > 0 Then
        ApplyMinimumWholeNumberValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            0
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_TODO_MAX)

    If targetRow > 0 Then
        ApplyWholeNumberValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            1, _
            ABSOLUTE_TODO_MAX
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_DAILY_MAX)

    If targetRow > 0 Then
        ApplyWholeNumberValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            1, _
            ABSOLUTE_DAILY_MAX
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_RECURRING_MAX)

    If targetRow > 0 Then
        ApplyWholeNumberValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            1, _
            ABSOLUTE_RECURRING_MAX
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_DATE_DROPDOWN_MONTHS)

    If targetRow > 0 Then
        ApplyMinimumWholeNumberValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            1
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_SATURDAY_IS_HOLIDAY)

    If targetRow > 0 Then
        ApplyListValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            Array("はい", "いいえ")
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_SUNDAY_IS_HOLIDAY)

    If targetRow > 0 Then
        ApplyListValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            Array("はい", "いいえ")
    End If

    targetRow = FindSettingRow( _
        settingsSheet, SETTING_SHOW_REGISTERED_MESSAGE)

    If targetRow > 0 Then
        ApplyListValidation _
            settingsSheet.Cells( _
                targetRow, COL_SETTING_VALUE), _
            Array("表示", "非表示")
    End If
End Sub

Private Function FindSettingRow( _
    ByVal settingsSheet As Worksheet, _
    ByVal settingName As String _
) As Long

    Dim foundCell As Range

    Set foundCell = settingsSheet.Columns( _
        COL_SETTING_NAME).Find( _
            What:=settingName, _
            After:=settingsSheet.Cells( _
                1, COL_SETTING_NAME), _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False)

    If Not foundCell Is Nothing Then
        FindSettingRow = foundCell.Row
    End If
End Function

