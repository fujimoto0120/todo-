    If Not isEnabled Then GoTo ExitHandler

    ClearRecurringRowError recurringSheet, targetRow

    If Not ValidateRecurringSettingRow( _
        recurringSheet, targetRow, errorMessage) Then

        SetRecurringCheckboxOff _
            recurringSheet, callerName, targetRow

        MarkRecurringRowError recurringSheet, targetRow

        MsgBox errorMessage, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    If GetRecurringSettingDataCount() > GetSettingLong( _
        SETTING_RECURRING_MAX, _
        DEFAULT_RECURRING_MAX, _
        1, _
        ABSOLUTE_RECURRING_MAX) Then

        SetRecurringCheckboxOff _
            recurringSheet, callerName, targetRow

        MsgBox "定期業務が設定された最大件数を超えています。", _
            vbExclamation, APP_TITLE

        GoTo ExitHandler
    End If

    EnsureRecurringTaskId recurringSheet, targetRow
    added = RegisterFirstRecurringTask(targetRow)

    If added Then
        SortTodoListCore
        RebuildTodoCheckboxes
        RefreshTodoDisplayCore
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If Len(callerName) > 0 _
        And targetRow >= DATA_FIRST_ROW Then

        SetRecurringCheckboxOff _
            recurringSheet, callerName, targetRow
    End If

    On Error GoTo 0

    ShowProcessError _
        "定期業務の有効化", _
        SHEET_RECURRING, _
        targetRow, _
        vbNullString, _
        errorText

    Resume ExitHandler
End Sub

Public Function RegisterFirstRecurringTask( _
    ByVal settingRow As Long _
) As Boolean

    Dim recurringSheet As Worksheet
    Dim taskId As String
    Dim originalDate As Date
    Dim dueDate As Date
    Dim noText As String
    Dim descriptionText As String
    Dim priorityText As String
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler

    Set recurringSheet = _
        ThisWorkbook.Worksheets(SHEET_RECURRING)

    taskId = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID))))

    originalDate = DateOnlyValue(recurringSheet.Cells( _
        settingRow, COL_RECURRING_FIRST_DATE).Value)

    If IsDuplicateTask( _
        TASK_TYPE_RECURRING, _
        taskId, _
        originalDate) Then

        Exit Function
    End If

    If Not CanAddTodoRows(1, True) Then Exit Function

    dueDate = GetAdjustedRecurringDueDate( _
        recurringSheet, settingRow, originalDate)

    noText = CStr(GetSafeCellValue(recurringSheet.Cells( _
        settingRow, COL_RECURRING_NO)))

    descriptionText = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_DESCRIPTION))))

    priorityText = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_PRIORITY))))

    CreateTemporaryBackup _
        "定期業務初回登録", _
        Array(SHEET_TODO_LIST)

    backupCreated = True

    AppendTodoRecord _
        dueDate, _
        dueDate, _
        noText, _
        descriptionText, _
        priorityText, _
        TASK_TYPE_RECURRING, _
        taskId, _
        originalDate, _
        settingRow

    ClearTemporaryBackup
    backupCreated = False
    RegisterFirstRecurringTask = True
    Exit Function

ErrorHandler:
    errorText = Err.Description

    If backupCreated Then
        RestoreTemporaryBackup
    End If

    Err.Raise vbObjectError + 1400, _
        "RegisterFirstRecurringTask", _
        errorText
End Function

Public Function CreateNextRecurringTask( _
    ByVal taskId As String, _
    ByVal currentOriginalDate As Date, _
    Optional ByVal settingRowHint As Long = 0 _
) As Boolean

    Dim recurringSheet As Worksheet
    Dim settingRow As Long
    Dim resolvedTaskId As String
    Dim nextOriginalDate As Date
    Dim dueDate As Date
    Dim errorMessage As String

    Set recurringSheet = _
        ThisWorkbook.Worksheets(SHEET_RECURRING)

    If Len(Trim$(taskId)) > 0 Then
        settingRow = FindRecurringSettingRow(taskId)
    End If

    If settingRow = 0 _
        And settingRowHint >= DATA_FIRST_ROW _
        And settingRowHint <= _
            DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1 Then

        settingRow = settingRowHint
    End If

    If settingRow = 0 Then
        Err.Raise vbObjectError + 1410, _
            "CreateNextRecurringTask", _
            "元の定期業務設定を確認できませんでした。"
    End If

    If Not RecurringRowIsEnabled( _
        recurringSheet, settingRow) Then

        Err.Raise vbObjectError + 1411, _
            "CreateNextRecurringTask", _
            "定期業務設定の「使用」が解除されています。"
    End If

    If Not ValidateRecurringSettingRow( _
        recurringSheet, settingRow, errorMessage) Then

        Err.Raise vbObjectError + 1401, _
            "CreateNextRecurringTask", _
            errorMessage
    End If

    EnsureRecurringTaskId recurringSheet, settingRow

    resolvedTaskId = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID))))

    If Len(resolvedTaskId) = 0 Then
        Err.Raise vbObjectError + 1412, _
            "CreateNextRecurringTask", _
            "定期業務IDを作成できませんでした。"
    End If

    nextOriginalDate = CalculateNextRecurringDate( _
        recurringSheet, _
        settingRow, _
        currentOriginalDate)

    If IsDuplicateTask( _
        TASK_TYPE_RECURRING, _
        resolvedTaskId, _
        nextOriginalDate) Then

        CreateNextRecurringTask = True
        Exit Function
    End If

    If Not CanAddTodoRows(1, False) Then
        Err.Raise vbObjectError + 1402, _
            "CreateNextRecurringTask", _
            MSG_TODO_LIMIT_REACHED
    End If

    dueDate = GetAdjustedRecurringDueDate( _
        recurringSheet, _
        settingRow, _
        nextOriginalDate)

    AppendTodoRecord _
        dueDate, _
        dueDate, _
        CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_NO))), _
        Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_DESCRIPTION)))), _
        Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_PRIORITY)))), _
        TASK_TYPE_RECURRING, _
        resolvedTaskId, _
        nextOriginalDate, _
        settingRow

    CreateNextRecurringTask = True
End Function

Public Sub ApplyRecurringChangesToOpenTodo()
    Dim savedState As TExcelState
    Dim recurringSheet As Worksheet
    Dim todoSheet As Worksheet
    Dim settingRow As Long
    Dim lastTodoRow As Long
    Dim todoRow As Long
    Dim taskId As String
    Dim currentOriginalDate As Date
    Dim nextOriginalDate As Date
    Dim dueDate As Date
    Dim errorMessage As String
    Dim updateCount As Long
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler

    If ActiveSheet.Name <> SHEET_RECURRING Then
        MsgBox "定期業務シートで対象行を選択してください。", _
            vbExclamation, APP_TITLE

        Exit Sub
    End If

    settingRow = ActiveCell.Row

    If settingRow < DATA_FIRST_ROW _
        Or settingRow > _
            DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1 Then

        MsgBox "変更を反映する設定行を選択してください。", _
            vbExclamation, APP_TITLE

        Exit Sub
    End If

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    Set recurringSheet = _
        ThisWorkbook.Worksheets(SHEET_RECURRING)

    If Not RecurringRowIsEnabled( _
        recurringSheet, settingRow) Then

        MsgBox "使用中の定期業務を選択してください。", _
            vbExclamation, APP_TITLE

        GoTo ExitHandler
    End If

    ClearRecurringRowError recurringSheet, settingRow

    If Not ValidateRecurringSettingRow( _
        recurringSheet, settingRow, errorMessage) Then

        MarkRecurringRowError recurringSheet, settingRow
        MsgBox errorMessage, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    EnsureRecurringTaskId recurringSheet, settingRow

    taskId = Trim$(CStr(GetSafeCellValue( _
        recurringSheet.Cells( _
            settingRow, COL_RECURRING_ID))))

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)
    lastTodoRow = GetLastDataRow(todoSheet)

    CreateTemporaryBackup _
        "定期業務変更反映", _
        Array(SHEET_TODO_LIST)

    backupCreated = True

    For todoRow = DATA_FIRST_ROW To lastTodoRow
        If Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
            todoRow, COL_TODO_TASK_TYPE)))) = _
            TASK_TYPE_RECURRING _
        And Trim$(CStr(GetSafeCellValue(todoSheet.Cells( _
            todoRow, COL_TODO_TASK_ID)))) = taskId Then

            If Not IsValidExcelDate(todoSheet.Cells( _
                todoRow, COL_TODO_ORIGINAL_DATE).Value) Then

                Err.Raise vbObjectError + 1403, _
                    "ApplyRecurringChangesToOpenTodo", _
                    "本来の予定日が不正です。"
            End If

            currentOriginalDate = DateOnlyValue( _
                todoSheet.Cells( _
                    todoRow, COL_TODO_ORIGINAL_DATE).Value)

            nextOriginalDate = CalculateRecurringDateOnOrAfter( _
                recurringSheet, _
                settingRow, _
                currentOriginalDate)

            If IsDuplicateTask( _
                TASK_TYPE_RECURRING, _
                taskId, _
                nextOriginalDate, _
                SHEET_TODO_LIST, _
                todoRow) Then

                Err.Raise vbObjectError + 1404, _
                    "ApplyRecurringChangesToOpenTodo", _
                    "変更後の日付に同じ定期業務が存在します。"
            End If

            dueDate = GetAdjustedRecurringDueDate( _
                recurringSheet, _
                settingRow, _
                nextOriginalDate)

            With todoSheet
                .Cells(todoRow, COL_TODO_DUE).Value = dueDate
                .Cells(todoRow, COL_TODO_ACTUAL_DUE).Value = dueDate

                .Cells(todoRow, COL_TODO_NO).NumberFormat = _
                    NO_DISPLAY_FORMAT

                .Cells(todoRow, COL_TODO_NO).Value = _
                    CStr(GetSafeCellValue(recurringSheet.Cells( _
                        settingRow, COL_RECURRING_NO)))

                .Cells(todoRow, COL_TODO_DESCRIPTION).Value = _
                    Trim$(CStr(GetSafeCellValue( _
                        recurringSheet.Cells( _
                            settingRow, _
                            COL_RECURRING_DESCRIPTION))))

                .Cells(todoRow, COL_TODO_PRIORITY).Value = _
                    Trim$(CStr(GetSafeCellValue( _
                        recurringSheet.Cells( _
                            settingRow, _
                            COL_RECURRING_PRIORITY))))

                .Cells( _
                    todoRow, COL_TODO_ORIGINAL_DATE).Value = _
                    nextOriginalDate

                .Cells(todoRow, COL_TODO_SOURCE_ROW).Value = _
                    settingRow

                .Cells( _
                    todoRow, COL_TODO_PROCESS_STATUS).Value = _
                    PROCESS_STATUS_CONFIRMED

                .Cells(todoRow, COL_TODO_PREVIOUS_KEY).Value = _
                    BuildTodoDataKey(todoSheet, todoRow)
            End With

            updateCount = updateCount + 1
        End If
    Next todoRow

    If updateCount = 0 Then
        ClearTemporaryBackup
        backupCreated = False

        If RegisterFirstRecurringTask(settingRow) Then
            SortTodoListCore
            RebuildTodoCheckboxes
            RefreshTodoDisplayCore
            MsgBox "設定を確認し、最初のToDoを登録しました。", _
                vbInformation, APP_TITLE
        Else
            MsgBox "設定を確認しました。追加または更新が必要なToDoはありません。", _
                vbInformation, APP_TITLE
        End If
    Else
        SortTodoListCore
        RebuildTodoCheckboxes
        RefreshTodoDisplayCore
        ClearTemporaryBackup
        backupCreated = False

        MsgBox CStr(updateCount) & _
            "件の未完了ToDoへ変更を反映しました。", _
            vbInformation, APP_TITLE
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If backupCreated Then
        RestoreTemporaryBackup
        RebuildTodoCheckboxes
    End If

    On Error GoTo 0

    ShowProcessError _
        "定期業務の変更反映", _
        SHEET_RECURRING, _
        settingRow, _
        taskId, _
        errorText

    Resume ExitHandler
End Sub

