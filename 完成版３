    messageText = "処理中にエラーが発生しました。" & vbCrLf & _
        "処理：" & processName

    If Len(sheetName) > 0 Then
        messageText = messageText & vbCrLf & "シート：" & sheetName
    End If

    If rowNumber > 0 Then
        messageText = messageText & vbCrLf & "行：" & CStr(rowNumber)
    End If

    If Len(taskId) > 0 Then
        messageText = messageText & vbCrLf & "業務ID：" & taskId
    End If

    If Len(errorDescription) > 0 Then
        messageText = messageText & vbCrLf & "内容：" & errorDescription
    End If

    If errorNumber <> 0 Then
        messageText = messageText & _
            vbCrLf & "エラー番号：" & CStr(errorNumber)
    End If

    MsgBox messageText, vbExclamation, APP_TITLE
End Sub

