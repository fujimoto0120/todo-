    Dim index As Long
    Dim weekdayIndex As Long
    Dim targetRow As Long
    Dim newLastRow As Long
    Dim refersToText As String
    Dim weekdayNames As Variant
    Dim listName As String
    Dim listLastRow As Long

    Set systemSheet = ThisWorkbook.Worksheets(SHEET_SYSTEM)
    startDate = Date
    endDate = GetDateDropdownEndDate(startDate)
    dayCount = DateDiff("d", startDate, endDate) + 1
    weekdayNames = Array("月曜日", "火曜日", "水曜日", "木曜日", "金曜日", "土曜日", "日曜日")

    systemSheet.Range( _
        systemSheet.Cells(DATA_FIRST_ROW, SYSTEM_DATE_LIST_COLUMN), _
        systemSheet.Cells(500, SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + 6)).ClearContents

    ReDim dateValues(1 To dayCount, 1 To 1)
    For index = 1 To dayCount
        dateValues(index, 1) = DateAdd("d", index - 1, startDate)
    Next index

    newLastRow = DATA_FIRST_ROW + dayCount - 1
    With systemSheet.Range( _
        systemSheet.Cells(DATA_FIRST_ROW, SYSTEM_DATE_LIST_COLUMN), _
        systemSheet.Cells(newLastRow, SYSTEM_DATE_LIST_COLUMN))
        .Value = dateValues
        .NumberFormat = DATE_DISPLAY_FORMAT
    End With

    On Error Resume Next
    ThisWorkbook.Names(TODO_DATE_LIST_NAME).Delete
    On Error GoTo 0

    refersToText = "='" & Replace(systemSheet.Name, "'", "''") & "'!" & _
        systemSheet.Range( _
            systemSheet.Cells(DATA_FIRST_ROW, SYSTEM_DATE_LIST_COLUMN), _
            systemSheet.Cells(newLastRow, SYSTEM_DATE_LIST_COLUMN)).Address

    ThisWorkbook.Names.Add _
        Name:=TODO_DATE_LIST_NAME, _
        RefersTo:=refersToText, _
        Visible:=False

    For weekdayIndex = 1 To 7
        targetRow = DATA_FIRST_ROW
        For index = 1 To dayCount
            If Weekday(CDate(dateValues(index, 1)), vbMonday) = weekdayIndex Then
                systemSheet.Cells( _
                    targetRow, _
                    SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + weekdayIndex - 1).Value = _
                    dateValues(index, 1)
                targetRow = targetRow + 1
            End If
        Next index

        listLastRow = targetRow - 1
        With systemSheet.Range( _
            systemSheet.Cells(DATA_FIRST_ROW, _
                SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + weekdayIndex - 1), _
            systemSheet.Cells(listLastRow, _
                SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + weekdayIndex - 1))
            .NumberFormat = DATE_DISPLAY_FORMAT
        End With

        listName = TODO_WEEKDAY_DATE_LIST_PREFIX & _
            CStr(weekdayNames(weekdayIndex - 1))

        On Error Resume Next
        ThisWorkbook.Names(listName).Delete
        On Error GoTo 0

        refersToText = "='" & Replace(systemSheet.Name, "'", "''") & "'!" & _
            systemSheet.Range( _
                systemSheet.Cells(DATA_FIRST_ROW, _
                    SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + weekdayIndex - 1), _
                systemSheet.Cells(listLastRow, _
                    SYSTEM_WEEKDAY_LIST_FIRST_COLUMN + weekdayIndex - 1)).Address

        ThisWorkbook.Names.Add _
            Name:=listName, _
            RefersTo:=refersToText, _
            Visible:=False
    Next weekdayIndex
End Sub
