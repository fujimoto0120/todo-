Public Sub HandleDailySettingChange()
    Dim savedState As TExcelState
    Dim dailySheet As Worksheet
    Dim callerName As String
    Dim targetRow As Long
    Dim isEnabled As Boolean
    Dim errorMessage As String
    Dim added As Boolean
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    Set dailySheet = ThisWorkbook.Worksheets(SHEET_DAILY)
    callerName = CStr(Application.Caller)
    targetRow = dailySheet.Shapes( _
        callerName).TopLeftCell.Row

    isEnabled = _
        (dailySheet.Shapes( _
            callerName).ControlFormat.Value = xlOn)

    dailySheet.Cells( _
        targetRow, COL_DAILY_ENABLED).Value = isEnabled

    If Not isEnabled Then GoTo ExitHandler

    ClearDailyRowError dailySheet, targetRow

    If Not ValidateDailySettingRow( _
        dailySheet, targetRow, errorMessage) Then

        SetDailyCheckboxOff _
            dailySheet, callerName, targetRow

        MarkDailyRowError dailySheet, targetRow

        MsgBox errorMessage, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    If GetDailySettingDataCount() > GetSettingLong( _
        SETTING_DAILY_MAX, _
        DEFAULT_DAILY_MAX, _
        1, _
        ABSOLUTE_DAILY_MAX) Then

        SetDailyCheckboxOff _
            dailySheet, callerName, targetRow

        MsgBox "毎日業務が設定された最大件数を超えています。", _
            vbExclamation, APP_TITLE

        GoTo ExitHandler
    End If

    EnsureDailyTaskId dailySheet, targetRow

    CreateTemporaryBackup _
        "毎日業務有効化", _
        Array(SHEET_TODO_LIST)

    backupCreated = True
    added = RegisterOneDailyTask(targetRow, Date)

    dailySheet.Cells( _
        targetRow, COL_DAILY_UPDATE_STATUS).Value = _
        UPDATE_STATUS_APPLIED

    If added Then
        SortTodoListCore
        RebuildTodoCheckboxes
        RefreshTodoDisplayCore
    End If

    ClearTemporaryBackup
    backupCreated = False

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description

    On Error Resume Next

    If backupCreated Then
        RestoreTemporaryBackup
        RebuildTodoCheckboxes
    End If

    If Len(callerName) > 0 _
        And targetRow >= DATA_FIRST_ROW Then

        SetDailyCheckboxOff _
            dailySheet, callerName, targetRow
    End If

    On Error GoTo 0

    ShowProcessError _
        "毎日業務の有効化", _
        SHEET_DAILY, _
        targetRow, _
        vbNullString, _
        errorText

    Resume ExitHandler
End Sub

Public Sub HandleDailySheetChange( _
    ByVal changedRange As Range _
)

    Dim savedState As TExcelState
    Dim dailySheet As Worksheet
    Dim watchedRange As Range
    Dim affectedRange As Range
    Dim rowNumbers As Object
    Dim targetCell As Range
    Dim rowKey As Variant
    Dim targetRow As Long
    Dim errorMessage As String

    On Error GoTo ErrorHandler

    If changedRange Is Nothing Then Exit Sub
    If changedRange.CountLarge > 1000 Then Exit Sub

    Set dailySheet = ThisWorkbook.Worksheets(SHEET_DAILY)

    Set watchedRange = dailySheet.Range( _
        dailySheet.Cells( _
            DATA_FIRST_ROW, COL_DAILY_NO), _
        dailySheet.Cells( _
            DATA_FIRST_ROW + ABSOLUTE_DAILY_MAX - 1, _
            COL_DAILY_PRIORITY))

    Set affectedRange = Intersect(changedRange, watchedRange)
    If affectedRange Is Nothing Then Exit Sub

    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    Set rowNumbers = CreateObject("Scripting.Dictionary")

    For Each targetCell In affectedRange.Cells
        If Not rowNumbers.Exists(CStr(targetCell.Row)) Then
            rowNumbers.Add CStr(targetCell.Row), True
        End If
    Next targetCell

    For Each rowKey In rowNumbers.Keys
        targetRow = CLng(rowKey)
        ClearDailyRowError dailySheet, targetRow

        If DailyRowIsEnabled(dailySheet, targetRow) Then
            If ValidateDailySettingRow( _
                dailySheet, targetRow, errorMessage) Then

                EnsureDailyTaskId dailySheet, targetRow
                UpdateTodayOpenDailyTodo _
                    dailySheet, targetRow

                dailySheet.Cells( _
                    targetRow, COL_DAILY_UPDATE_STATUS).Value = _
                    UPDATE_STATUS_APPLIED
            Else
                MarkDailyRowError dailySheet, targetRow

                MsgBox CStr(targetRow) & "行：" & _
                    errorMessage, _
                    vbExclamation, APP_TITLE
            End If
        End If
    Next rowKey

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    ShowProcessError _
        "毎日業務の変更反映", _
        SHEET_DAILY, _
        targetRow, _
        vbNullString, _
        Err.Description

    Resume ExitHandler
End Sub

Public Function ValidateDailySettingRow( _
    ByVal dailySheet As Worksheet, _
    ByVal rowNumber As Long, _
    ByRef errorMessage As String _
) As Boolean

    Dim descriptionText As String
    Dim priorityText As String

    errorMessage = vbNullString

    If rowNumber < DATA_FIRST_ROW _
        Or rowNumber > _
            DATA_FIRST_ROW + ABSOLUTE_DAILY_MAX - 1 Then

        errorMessage = "毎日業務のデータ行ではありません。"
        Exit Function
    End If

    descriptionText = Trim$(CStr(GetSafeCellValue( _
        dailySheet.Cells( _
            rowNumber, COL_DAILY_DESCRIPTION))))

    If Len(descriptionText) = 0 Then
        errorMessage = "行うことを入力してください。"
        Exit Function
    End If

    priorityText = Trim$(CStr(GetSafeCellValue( _
        dailySheet.Cells( _
            rowNumber, COL_DAILY_PRIORITY))))

    If Not IsAllowedPriority(priorityText) Then
        errorMessage = _
            "優先度は「高」「中」「低」または空欄にしてください。"

        Exit Function
    End If

    ValidateDailySettingRow = True
End Function

Private Sub RegisterTodayDailyTasksCore( _
    ByVal showResultMessage As Boolean _
)
    Dim savedState As TExcelState
    Dim recurringSheet As Worksheet
    Dim lastRow As Long
    Dim rowNumber As Long
    Dim errorMessage As String
    Dim errorList As String
    Dim taskId As String
    Dim firstDate As Date
    Dim addedCount As Long
    Dim backupCreated As Boolean
    Dim errorText As String

    On Error GoTo ErrorHandler
    CaptureExcelState savedState

    With Application
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    If Not WorksheetExists(SHEET_RECURRING) _
        Or Not WorksheetExists(SHEET_TODO_LIST) Then

        If showResultMessage Then MsgBox MSG_SETUP_REQUIRED, vbExclamation, APP_TITLE
        GoTo ExitHandler
    End If

    Set recurringSheet = ThisWorkbook.Worksheets(SHEET_RECURRING)
    lastRow = GetLastDataRow(recurringSheet)
    If lastRow > DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1 Then
        lastRow = DATA_FIRST_ROW + ABSOLUTE_RECURRING_MAX - 1
    End If

    For rowNumber = DATA_FIRST_ROW To lastRow
        If RecurringRowIsEnabled(recurringSheet, rowNumber) _
            And Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
                rowNumber, COL_RECURRING_TYPE)))) = RECURRING_TYPE_DAILY Then

            errorMessage = vbNullString
            If ValidateRecurringSettingRow( _
                recurringSheet, rowNumber, errorMessage) Then

                firstDate = DateOnlyValue(recurringSheet.Cells( _
                    rowNumber, COL_RECURRING_FIRST_DATE).Value)

                If Date >= firstDate And Not IsHoliday(Date) Then
                    EnsureRecurringTaskId recurringSheet, rowNumber
                    taskId = Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
                        rowNumber, COL_RECURRING_ID))))

                    If Not IsDuplicateTask( _
                        TASK_TYPE_RECURRING, taskId, Date) Then

                        If Not backupCreated Then
                            CreateTemporaryBackup _
                                "毎日業務登録", Array(SHEET_TODO_LIST)
                            backupCreated = True
                        End If

                        If Not CanAddTodoRows(1, showResultMessage) Then GoTo FinishRegistration
                        If RegisterOneDailyTask(rowNumber, Date) Then
                            addedCount = addedCount + 1
                        End If
                    End If
                End If
            Else
                MarkRecurringRowError recurringSheet, rowNumber
                errorList = errorList & CStr(rowNumber) & "行：" & _
                    errorMessage & vbCrLf
            End If
        End If
    Next rowNumber

FinishRegistration:
    If addedCount > 0 Then
        SortTodoListCore
        RebuildTodoCheckboxes
        RefreshTodoDisplayCore
    End If

    If backupCreated Then
        ClearTemporaryBackup
        backupCreated = False
    End If

    If showResultMessage Then
        If Len(errorList) > 0 Then
            MsgBox "登録できない設定があります。" & vbCrLf & vbCrLf & _
                errorList, vbExclamation, APP_TITLE
        Else
            MsgBox CStr(addedCount) & "件の毎日業務を追加しました。", _
                vbInformation, APP_TITLE
        End If
    End If

ExitHandler:
    RestoreExcelState savedState
    Exit Sub

ErrorHandler:
    errorText = Err.Description
    On Error Resume Next
    If backupCreated Then
        RestoreTemporaryBackup
        RebuildTodoCheckboxes
    End If
    On Error GoTo 0

    If showResultMessage Then
        ShowProcessError _
            "今日の毎日業務登録", _
            SHEET_RECURRING, _
            rowNumber, _
            vbNullString, _
            errorText
    End If
    Resume ExitHandler
End Sub
Private Function RegisterOneDailyTask( _
    ByVal settingRow As Long, _
    ByVal targetDate As Date _
) As Boolean
    Dim recurringSheet As Worksheet
    Dim taskId As String

    Set recurringSheet = ThisWorkbook.Worksheets(SHEET_RECURRING)

    If Not RecurringRowIsEnabled(recurringSheet, settingRow) Then Exit Function
    If Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
        settingRow, COL_RECURRING_TYPE)))) <> RECURRING_TYPE_DAILY Then Exit Function
    If IsHoliday(targetDate) Then Exit Function

    If DateValue(targetDate) < DateOnlyValue(recurringSheet.Cells( _
        settingRow, COL_RECURRING_FIRST_DATE).Value) Then Exit Function

    taskId = Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
        settingRow, COL_RECURRING_ID))))

    If IsDuplicateTask(TASK_TYPE_RECURRING, taskId, targetDate) Then Exit Function
    If Not CanAddTodoRows(1, True) Then Exit Function

    AppendTodoRecord _
        DateValue(targetDate), _
        DateValue(targetDate), _
        CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_NO))), _
        Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_DESCRIPTION)))), _
        Trim$(CStr(GetSafeCellValue(recurringSheet.Cells( _
            settingRow, COL_RECURRING_PRIORITY)))), _
        TASK_TYPE_RECURRING, _
        taskId, _
        DateValue(targetDate), _
        settingRow

    RegisterOneDailyTask = True
End Function
Private Sub UpdateTodayOpenDailyTodo( _
    ByVal dailySheet As Worksheet, _
    ByVal settingRow As Long _
)

    Dim todoSheet As Worksheet
    Dim taskId As String
    Dim todoRow As Long
    Dim backupCreated As Boolean
    Dim savedErrorNumber As Long
    Dim savedErrorText As String

    taskId = Trim$(CStr(GetSafeCellValue(dailySheet.Cells( _
        settingRow, COL_DAILY_ID))))

    todoRow = FindOpenTodoRowByTaskId( _
        TASK_TYPE_DAILY, taskId, Date)

    If todoRow = 0 Then Exit Sub

    Set todoSheet = ThisWorkbook.Worksheets(SHEET_TODO_LIST)

    On Error GoTo ErrorHandler

    CreateTemporaryBackup _
        "毎日業務変更", _
        Array(SHEET_TODO_LIST)

    backupCreated = True

    With todoSheet
        .Cells(todoRow, COL_TODO_DUE).Value = Date
        .Cells(todoRow, COL_TODO_ACTUAL_DUE).Value = Date

        .Cells(todoRow, COL_TODO_NO).NumberFormat = _
            NO_DISPLAY_FORMAT

        .Cells(todoRow, COL_TODO_NO).Value = _
            CStr(GetSafeCellValue(dailySheet.Cells( _
                settingRow, COL_DAILY_NO)))

        .Cells(todoRow, COL_TODO_DESCRIPTION).Value = _
            Trim$(CStr(GetSafeCellValue(dailySheet.Cells( _
                settingRow, COL_DAILY_DESCRIPTION))))

        .Cells(todoRow, COL_TODO_PRIORITY).Value = _
            Trim$(CStr(GetSafeCellValue(dailySheet.Cells( _
                settingRow, COL_DAILY_PRIORITY))))

        .Cells(todoRow, COL_TODO_PROCESS_STATUS).Value = _
            PROCESS_STATUS_CONFIRMED

        .Cells(todoRow, COL_TODO_PREVIOUS_KEY).Value = _
            BuildTodoDataKey(todoSheet, todoRow)
    End With

    SortTodoListCore
    RebuildTodoCheckboxes
    RefreshTodoDisplayCore
    ClearTemporaryBackup
    backupCreated = False
    Exit Sub

ErrorHandler:
    savedErrorNumber = Err.Number
    savedErrorText = Err.Description

    If backupCreated Then
        RestoreTemporaryBackup
    End If

    Err.Raise savedErrorNumber, _
        "UpdateTodayOpenDailyTodo", _
        savedErrorText
End Sub

Private Sub EnsureDailyTaskId( _
